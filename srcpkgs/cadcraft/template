# Template for 'cadcraft'
pkgname=cadcraft
version=0.10.0
revision=1
build_style=cargo
make_build_args="-p cadcraft -p cadcraft-cli"
hostmakedepends="pkg-config"
#makedepends="fontconfig-devel freetype-devel libX11-devel libXcursor-devel libXi-devel libXrandr-devel libxkbcommon-devel wayland-devel"
short_desc="Fast, open-source computer-aided design and drafting application"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="Apache-2.0, MIT"
homepage="https://getartcraft.com/apps/cadcraft"
distfiles="https://github.com/storytold/cadcraft/archive/refs/tags/v${version}.tar.gz"

checksum="fb8df3ce93c0d8dc7702f95683197fd8f50c1af210e382b05627020ed862b29f"

do_install() {
	# 1. Install optimized application binaries
	vbin target/${RUST_TARGET}/release/cadcraft
	vbin target/${RUST_TARGET}/release/cadcraft-cli

	# 2. Install desktop application shortcut, appstream metadata, and custom mime types
	if [ -d "packaging/linux" ]; then
		vinstall packaging/linux/ai.storyteller.cadcraft.desktop 644 usr/share/applications
		vinstall packaging/linux/ai.storyteller.cadcraft.mime.xml 644 usr/share/mime/packages ai.storyteller.cadcraft.xml
		vinstall packaging/linux/ai.storyteller.cadcraft.metainfo.xml.in 644 usr/share/metainfo ai.storyteller.cadcraft.metainfo.xml
	fi

	# 3. Iterate over the standard hicolor icon paths and install them with the proper app ID name
	local size
	for size in 16x16 24x24 32x32 48x48 64x64 128x128 256x256 512x512; do
		if [ -f "assets/app-icon/hicolor/${size}/apps/ai.storyteller.cadcraft.png" ]; then
			vinstall "assets/app-icon/hicolor/${size}/apps/ai.storyteller.cadcraft.png" \
				644 "usr/share/icons/hicolor/${size}/apps"
		fi
	done

	if [ -f "assets/app-icon/hicolor/scalable/apps/ai.storyteller.cadcraft.svg" ]; then
		vinstall "assets/app-icon/hicolor/scalable/apps/ai.storyteller.cadcraft.svg" \
			644 "usr/share/icons/hicolor/scalable/apps"
	fi

	# 4. Install standard software licenses and the legal NOTICE file
	vlicense LICENSE-APACHE
	vlicense LICENSE-MIT
	if [ -f "NOTICE" ]; then
		vlicense NOTICE
	fi

	# 5. Technical documentation in Markdown
	if [ -d "docs" ]; then
		local docfile
		for docfile in docs/*.md; do
			if [ -f "$docfile" ]; then
				vdoc "$docfile"
			fi
		done
	fi
}
