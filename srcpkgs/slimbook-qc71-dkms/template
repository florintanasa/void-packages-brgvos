# Template file for 'slimbook-qc71-dkms'
pkgname=slimbook-qc71-dkms
version=1.3.2 # Adjust based on latest tag
revision=5
# We only install sources, so no_target is appropriate
no_target=yes
# DKMS is required to build the module on the target system
depends="dkms"
dkms_modules="slimbook-qc71 ${version}"
short_desc="Slimbook QC71 kernel driver (DKMS)"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="GPL-2.0-only"
homepage="https://github.com/Slimbook-Team/qc71_laptop"
distfiles="https://github.com/Slimbook-Team/qc71_laptop/archive/refs/tags/${version}.tar.gz>slimbook-qc71-dkms-${version}.tar.gz"

checksum="b4382172a672e012815b380b75318fa1d4a1668377dbe05b075ce9ad71bf16c6"

wrksrc="qc71_laptop-${version}"

do_install() {
    # Fix compatibility with battery API names across all kernels (6.18 / 7.2 / 7.3+)
    # This maps acpi_battery_hook_* safely to battery_hook_* if the macros are missing,
    # ensuring complete safety and zero side effects for all BIOS versions.
    sed -i '/#include <acpi\/battery.h>/a \
#ifndef battery_hook_register\n#define acpi_battery_hook_register battery_hook_register\n#define acpi_battery_hook_unregister battery_hook_unregister\n#endif' battery.c

    # Target directory in /usr/src/
    local dkms_dir="usr/src/slimbook-qc71-${version}"
    vmkdir "${dkms_dir}"

    # Copy files from the extracted wrksrc to the destination
    vcopy "*" "${dkms_dir}"

    # Install our custom dkms.conf
    vinstall "${FILESDIR}/dkms.conf" 644 "${dkms_dir}"

    # Install License
    vlicense LICENSE
}
