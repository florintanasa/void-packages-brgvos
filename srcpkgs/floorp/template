maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="MPL-2.0"
homepage="https://floorp.app/"
changelog="https://blog.floorp.app/en/release/${version}/"
distfiles="https://github.com/Floorp-Projects/Floorp/releases/download/v${version}/floorp-linux-x86_64.tar.xz
 https://raw.githubusercontent.com/Floorp-Projects/Floorp/refs/heads/main/LICENSE>LICENSE"

checksum="059a85f0e40c9f3649ae61fe716ecbdde85f06971a600aeec5c3e8f3a0af6004
 1f256ecad192880510e84ad60474eab7589218784b9a50bc7ceee34c2b91f1d5"

skip_extraction="LICENSE"

nopie=yes

do_install() {
    # 1. Copy all files in opt/palemoon 
    vmkdir opt/floorp
    vcopy * opt/floorp

    # 2. Create simbolic link to the binary 
    vmkdir usr/bin
    ln -s /opt/floorp/floorp "${DESTDIR}/usr/bin/floorp"

    # 3. Copy menu file
    vmkdir usr/share/applications
    vinstall "${FILESDIR}/floorp.desktop" 644 usr/share/applications/

    # 4. Include license
    vlicense ${XBPS_SRCDISTDIR}/${pkgname}-${version}/LICENSE
}
