# Template for 'filmcraft'
pkgname=filmcraft
version=0.9.0
revision=1
build_style=cargo
make_build_args="-p filmcraft -p filmcraft-cli"
hostmakedepends="pkg-config"
makedepends="alsa-lib-devel"
short_desc="Professional, open-source video editing software built in pure Rust"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="Apache-2.0, MIT"
homepage="https://getartcraft.com/apps/filmcraft"
distfiles="https://github.com/storytold/filmcraft/archive/refs/tags/v${version}.tar.gz"

checksum="875e19a57479f79a87dbf21bda4d5a25fe99f65c38caa22b73fd4f6056778756"

do_install() {
	# 1. Install application for Desktop and command line (CLI) 
	vbin target/${RUST_TARGET}/release/filmcraft
	vbin target/${RUST_TARGET}/release/filmcraft-cli

	# 2. Install shortcut in menu (.desktop) and mime types
	vinstall packaging/linux/ai.storyteller.filmcraft.desktop 644 usr/share/applications
	vinstall packaging/linux/ai.storyteller.filmcraft.mime.xml 644 usr/share/mime/packages
	vinstall packaging/linux/ai.storyteller.filmcraft.metainfo.xml.in 644 usr/share/metainfo ai.storyteller.filmcraft.metainfo.xml

	# 3. Iterate icons and install
	local size
	for size in 16x16 24x24 32x32 48x48 64x64 128x128 256x256 512x512; do
		if [ -f "assets/app-icon/hicolor/${size}/apps/ai.storyteller.filmcraft.png" ]; then
			vinstall "assets/app-icon/hicolor/${size}/apps/ai.storyteller.filmcraft.png" \
				644 "usr/share/icons/hicolor/${size}/apps"
		fi
	done

	if [ -f "assets/app-icon/hicolor/scalable/apps/ai.storyteller.filmcraft.svg" ]; then
		vinstall "assets/app-icon/hicolor/scalable/apps/ai.storyteller.filmcraft.svg" \
			644 "usr/share/icons/hicolor/scalable/apps"
	fi

	# 4. Install licenses
	vlicense LICENSE-APACHE
	vlicense LICENSE-MIT

	# 5. Technical documentation in Markdown
	local docfile
	for docfile in docs/*.md; do
		if [ -f "$docfile" ]; then
			vdoc "$docfile"
		fi
	done
}
