#!/bin/sh
# This script runs after the package files are unpacked on the target system
case "$1" in
post)
    # Check if flatpak is installed on the host system before executing overrides
    if command -v flatpak >/dev/null 2>&1; then
        echo "Configuring global Flatpak overrides for GTK theme consistency..."
        flatpak override --system --filesystem=xdg-config/gtk-3.0
        flatpak override --system --filesystem=xdg-config/gtk-4.0
    else
        echo "Flatpak is not installed, skipping theme overrides."
    fi
    ;;
esac
