# Template file for 'gnome-shell-extension-accent-gtk-theme'
pkgname=gnome-shell-extension-accent-gtk-theme
version=8
revision=1
hostmakedepends="unzip"
depends="gnome-shell glib"
short_desc="Makes GTK theme to follow system accent color and color scheme Light or Dark"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://extensions.gnome.org"
distfiles="${homepage}/extension-data/accent-gtk-themebrgvos.v${version}.shell-extension.zip"

checksum="448460b61035b23d6f309133af3fd20dc805725c5867af4fe3b1e6ec7880204d"

do_extract() {
	# Unzip the official .zip archive into the temporary working directory of xbps-src
	unzip -d ${wrksrc} ${XBPS_SRCDISTDIR}/${pkgname}-${version}/accent-gtk-themebrgvos.v${version}.shell-extension.zip
}

do_install() {
	# The exact UUID used in the BRGV-OS distribution
	local uuid="accent-gtk-theme@brgvos"
	local extdir="usr/share/gnome-shell/extensions/${uuid}"

	# 1. Create the global system extensions path inside the package
	vmkdir "${extdir}"
	
	# 2. Copy all files extracted from zip directly to system destination
	vcopy "*" "${extdir}"

	# 3. Ensure schemas directory exists (required for compilation)
	vmkdir "${extdir}/schemas"
}
