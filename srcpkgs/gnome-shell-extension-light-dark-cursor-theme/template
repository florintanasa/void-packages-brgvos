# Template file for 'gnome-shell-extension-light-dark-cursor-theme'
pkgname=gnome-shell-extension-light-dark-cursor-theme
version=2
revision=1
hostmakedepends="unzip"
depends="gnome-shell glib"
short_desc="Makes cursor theme follow system color scheme"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="GPL-2.0"
homepage="https://extensions.gnome.org"
distfiles="${homepage}/extension-data/light-dark-cursor-themebrgvos.v${version}.shell-extension.zip
 https://raw.githubusercontent.com/florintanasa/light-dark-cursor-theme/refs/heads/main/LICENSE.md"

checksum="cb87ae0cf228c2d7c87e61a51df28d3841f056cbaff1cb5e1d1f955b8f050f22
 addb1c67a9dc2334f5d3f5ee416451266cf040d787070903cca6b9d99d6331a3"

do_extract() {
	# Unzip the official .zip archive into the temporary working directory of xbps-src
	unzip -d ${wrksrc} ${XBPS_SRCDISTDIR}/${pkgname}-${version}/light-dark-cursor-themebrgvos.v${version}.shell-extension.zip
	# Copy LICENSE
	cp ${XBPS_SRCDISTDIR}/${pkgname}-${version}/LICENSE.md ${wrksrc}/
}

do_install() {
	# Local variables
	local uuid="light-dark-cursor-theme@brgvos"
	local extdir="usr/share/gnome-shell/extensions/${uuid}"

	# 1. Install License
	vlicense LICENSE.md

	# 2. Create the global system extensions path inside the package
	vmkdir "${extdir}"
	
	# 3. Copy all files extracted from zip directly to system destination
	vcopy "*" "${extdir}"

	# 4. Make clean
	rm -f "${DESTDIR}/${extdir}/LICENSE.md"

	# 5. Ensure schemas directory exists (required for compilation)
	vmkdir "${extdir}/schemas"
}
