# Template file for 'MacTahoe-cursors-theme'
pkgname=MacTahoe-cursors-theme
version=0.1.0
revision=1
hostmakedepends="tar"
depends=""
short_desc="MacOS Tahoe cursor theme suite for linux desktops"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/florintanasa/MacTahoe-icon-theme"
distfiles="${homepage}/releases/download/v${version}/MacTahoe-cursors-all.tar.gz
 ${homepage}/raw/main/COPYING"

checksum="451d1c8b1e5c1c814d23130de7af4eda3fcc1342dee765fb2fbbf7c8a0bd1df2
 8ceb4b9ee5adedde47b31e975c1d90c73ad27b6b165a1dcd80c7c545eb65b903"

do_extract() {
	tar -xzf ${XBPS_SRCDISTDIR}/${pkgname}-${version}/MacTahoe-cursors-all.tar.gz -C ${wrksrc}
	cp ${XBPS_SRCDISTDIR}/${pkgname}-${version}/COPYING ${wrksrc}/
}

do_install() {
	local icondir="usr/share/icons"

	# 1. Create primary target layout structure inside destdir
	vmkdir "${icondir}"

	# 2. Safely copy
	cp -a . "${DESTDIR}/${icondir}/"

	# 3. Purge the cloned license file from system icons root
	rm -f "${DESTDIR}/${icondir}/COPYING"
	
	# 4. Enforce strict standard UNIX permissions across all assets
	find "${DESTDIR}/${icondir}" -type f -exec chmod 644 {} +
	find "${DESTDIR}/${icondir}/" -type d -exec chmod 755 {} +

	# 5. Extract and register the license cleanly into /usr/share/licenses/
	vlicense COPYING
}
