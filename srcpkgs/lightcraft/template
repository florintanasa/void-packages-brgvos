# Template for 'lightcraft'
pkgname=lightcraft
version=0.6.0
revision=1
build_style=cargo
make_build_args="-p lightcraft -p lightcraft-cli"
hostmakedepends="pkg-config"
# makedepends="fontconfig-devel freetype-devel libX11-devel libXcursor-devel libXi-devel libXrandr-devel libxkbcommon-devel wayland-devel"
short_desc="Open-source, clean-room reimplementation of Adobe Lightroom in pure Rust"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="Apache-2.0, MIT"
homepage="https://getartcraft.com/apps/lightcraft"
distfiles="https://github.com/storytold/lightcraft/archive/refs/tags/v${version}.tar.gz"

checksum="c346ce2e50cf50ce691925fc0fe57a07e316dc66195be6749755dec84546e6d9"

do_install() {
	# 1. Install application for Desktop and command line (CLI)
	vbin target/${RUST_TARGET}/release/lightcraft
	vbin target/${RUST_TARGET}/release/lightcraft-cli

	# 2. Install shortcut in menu (.desktop) and mime types
	vinstall packaging/linux/ai.storyteller.lightcraft.desktop 644 usr/share/applications
	vinstall packaging/linux/ai.storyteller.lightcraft.mime.xml 644 usr/share/mime/packages ai.storyteller.lightcraft.xml
    vinstall packaging/linux/ai.storyteller.lightcraft.metainfo.xml.in 644 usr/share/metainfo ai.storyteller.lightcraft.metainfo.xml

	# 3. Iterate icons and install
	local size
	for size in 16x16 24x24 32x32 48x48 64x64 128x128 256x256 512x512; do
		if [ -f "assets/app-icon/hicolor/${size}/apps/ai.storyteller.lightcraft.png" ]; then
			vinstall "assets/app-icon/hicolor/${size}/apps/ai.storyteller.lightcraft.png" \
				644 "usr/share/icons/hicolor/${size}/apps"
		fi
	done

	if [ -f "assets/app-icon/hicolor/scalable/apps/ai.storyteller.lightcraft.svg" ]; then
		vinstall "assets/app-icon/hicolor/scalable/apps/ai.storyteller.lightcraft.svg" \
			644 "usr/share/icons/hicolor/scalable/apps"
	fi

    # 4. Install licenses and legal NOTICE
	vlicense LICENSE-APACHE
	vlicense LICENSE-MIT
	if [ -f "NOTICE" ]; then
		vlicense NOTICE
	fi

	# 5. Technical documentation in Markdown
	local docfile
	for docfile in docs/*.md; do
		if [ -f "$docfile" ]; then
			vdoc "$docfile"
		fi
	done
}
