# Template for 'effectcraft'
pkgname=effectcraft
version=0.8.0
revision=1
build_style=cargo
make_build_args="-p effectcraft -p effectcraft-cli"
hostmakedepends="pkg-config"
makedepends="alsa-lib-devel"
short_desc="Open-source motion graphics and visual effects compositor in pure Rust"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="Apache-2.0, MIT"
homepage="https://getartcraft.com/apps/effectcraft"
distfiles="https://github.com/storytold/effectcraft/archive/refs/tags/v${version}.tar.gz"

checksum="2cf9187c0175e0439c738b651840b7cd52935a50cf4ae717a847e3f61829432d"

do_install() {
	# 1. Install application for Desktop and command line (CLI)
	vbin target/${RUST_TARGET}/release/effectcraft
	vbin target/${RUST_TARGET}/release/effectcraft-cli

	# 2. Install shortcut in menu (.desktop) and mime types from upstream packaging
	if [ -d "packaging/linux" ]; then
		vinstall packaging/linux/ai.storyteller.effectcraft.desktop 644 usr/share/applications
		vinstall packaging/linux/ai.storyteller.effectcraft.mime.xml 644 usr/share/mime/packages ai.storyteller.effectcraft.xml
		vinstall packaging/linux/ai.storyteller.effectcraft.metainfo.xml.in 644 usr/share/metainfo ai.storyteller.effectcraft.metainfo.xml
	fi

	# 3. Iterate icons and install complete hicolor multi-resolution tree
	local size
	for size in 16x16 24x24 32x32 48x48 64x64 128x128 256x256 512x512; do
		if [ -f "assets/app-icon/hicolor/${size}/apps/ai.storyteller.effectcraft.png" ]; then
			vinstall "assets/app-icon/hicolor/${size}/apps/ai.storyteller.effectcraft.png" \
				644 "usr/share/icons/hicolor/${size}/apps"
		fi
	done

	if [ -f "assets/app-icon/hicolor/scalable/apps/ai.storyteller.effectcraft.svg" ]; then
		vinstall "assets/app-icon/hicolor/scalable/apps/ai.storyteller.effectcraft.svg" \
			644 "usr/share/icons/hicolor/scalable/apps"
	fi

	# 4. Install licenses and legal NOTICE
	vlicense LICENSE-APACHE
	vlicense LICENSE-MIT
	if [ -f "NOTICE" ]; then
		vlicense NOTICE
	fi

	# 5. Technical documentation in Markdown
	if [ -d "docs" ]; then
		local docfile
		for docfile in docs/*.md; do
			if [ -f "$docfile" ]; then
				vdoc "$docfile"
			fi
		done
	fi
}
