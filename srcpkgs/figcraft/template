# Template for 'figcraft'
pkgname=figcraft
version=0.10.0
revision=1
build_style=cargo
make_build_args="-p figcraft -p figcraft-cli"
hostmakedepends="pkg-config"
#makedepends="fontconfig-devel freetype-devel libX11-devel libXcursor-devel libXi-devel libXrandr-devel libxkbcommon-devel wayland-devel"
short_desc="Open-source UI/UX interface design and prototyping tool in pure Rust"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="Apache-2.0, MIT"
homepage="https://getartcraft.com"
distfiles="https://github.com/storytold/figcraft/archive/refs/tags/v${version}.tar.gz"

checksum="f1e90b9d6a0733f01c4c4972bc667c6fb4834aa837310059255cc0194560d566"

do_install() {
	# 1. Install optimized application binaries directly from target release (prevents double compilation)
	vbin target/${RUST_TARGET}/release/figcraft
	vbin target/${RUST_TARGET}/release/figcraft-cli

	# 2. Install desktop application shortcut, appstream metadata, and custom mime types
	if [ -d "packaging/linux" ]; then
		vinstall packaging/linux/ai.storyteller.figcraft.desktop 644 usr/share/applications
		vinstall packaging/linux/ai.storyteller.figcraft.mime.xml 644 usr/share/mime/packages ai.storyteller.figcraft.xml
		vinstall packaging/linux/ai.storyteller.figcraft.metainfo.xml.in 644 usr/share/metainfo ai.storyteller.figcraft.metainfo.xml
	fi

	# 3. Iterate over the standard hicolor icon paths and install them with the proper app ID name
	local size
	for size in 16x16 24x24 32x32 48x48 64x64 128x128 256x256 512x512; do
		if [ -f "assets/app-icon/hicolor/${size}/apps/ai.storyteller.figcraft.png" ]; then
			vinstall "assets/app-icon/hicolor/${size}/apps/ai.storyteller.figcraft.png" \
				644 "usr/share/icons/hicolor/${size}/apps"
		fi
	done

	if [ -f "assets/app-icon/hicolor/scalable/apps/ai.storyteller.figcraft.svg" ]; then
		vinstall "assets/app-icon/hicolor/scalable/apps/ai.storyteller.figcraft.svg" \
			644 "usr/share/icons/hicolor/scalable/apps"
	fi

	# 4. Install standard software licenses and the legal NOTICE file
	vlicense LICENSE-APACHE
	vlicense LICENSE-MIT
	if [ -f "NOTICE" ]; then
		vlicense NOTICE
	fi

	# 5. Technical documentation in Markdown
	if [ -d "docs" ]; then
		local docfile
		for docfile in docs/*.md; do
			if [ -f "$docfile" ]; then
				vdoc "$docfile"
			fi
		done
	fi
}
