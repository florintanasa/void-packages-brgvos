# Template file for 'strata'
pkgname=strata
version=1.1.0
revision=1
build_style=cargo
# Exclude non-free RAR extraction capabilities to respect strict open-source policy
cargo_features="--no-default-features"
hostmakedepends="pkg-config"
makedepends="gtk4-devel gtksourceview5-devel poppler-glib-devel fontconfig-devel gstreamer1-devel gst-plugins-base1-devel glib-devel"
# Core and optional dependencies mapping Arch to Void Linux layout
# Includes SMB network shares, AppImage icon extraction, and camera RAW preview engines
depends="bubblewrap gvfs gvfs-smb ffmpeg ffmpegthumbnailer fontconfig
 gst-libav gst-plugins-base1 gst-plugins-good1 gtk4 gtksourceview5 poppler-glib
 ImageMagick libraw dcraw squashfs-tools desktop-file-utils hicolor-icon-theme"
short_desc="Fast, keyboard-first file manager for modern desktops written in Rust"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="MIT"
homepage="https://stratafiles.io"
distfiles="https://github.com/lgse/strata/archive/refs/tags/v${version}.tar.gz"

checksum="ed17c2e8457ebed01a99dc9e8accdde283ee6c744e2cb56c3ef380a9430bd11b"

do_install() {
	# Install the compiled binaries from the standard rust release target
	vbin target/${RUST_TARGET}/release/strata

	# Install system integration launcher and D-Bus services from the data folder
	vinstall data/io.github.lgse.Strata.desktop 644 usr/share/applications
	vinstall data/io.github.lgse.Strata.FileManager1.service 644 usr/share/dbus-1/services
	
	# Install application vector icon from its verified path inside data directory
	vinstall data/icons/scalable/apps/io.github.lgse.Strata.svg 644 usr/share/icons/hicolor/scalable/apps

	vlicense LICENSE
}
