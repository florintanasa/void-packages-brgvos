# Template for 'euro-office-help'
pkgname=euro-office-help
version=9.3.6
revision=1
create_wrksrc=yes
hostmakedepends="xz"
# Required
depends="euro-office-desktopeditors"
 # Skip the mandatory Position-Independent Executable verification for pre-built binaries
nopie=yes
allow_unknown_shlibs=yes
noshlibdeps=yes
short_desc="Help for Euro-Office Desktop Editors"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="AGPL-3.0-only"
homepage="https://github.com/Euro-Office/DesktopEditors/"

# We fetch only help package
_base_url="https://github.com/Euro-Office/DesktopEditors/releases/download/v${version}"
distfiles="${_base_url}/euro-office-euro-office-help-${version}-0-any.tar.xz"

# sha256 checksums matching the archive fetched by XBPS-src
checksum="981edaee10f3941445248626e0558d6dba79a5223f795c8d438b01394d823637"

archs="x86_64"

do_install() {
	# Deploy the files into the global storage directory /opt
	vmkdir opt/euro-office
	cp -R opt/euro-office/euro-office "${DESTDIR}/opt/euro-office/"
}
