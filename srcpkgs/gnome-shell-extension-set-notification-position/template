# Template file for 'gnome-shell-extension-set-notification-position'
pkgname=gnome-shell-extension-set-notification-position
version=3
revision=2
hostmakedepends="unzip"
depends="gnome-shell glib"
short_desc="Changes position of the notification banner"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="GPL-2.0"
homepage="https://extensions.gnome.org"
distfiles="${homepage}/extension-data/set-notification-positionbrgvos.v${version}.shell-extension.zip
 https://raw.githubusercontent.com/florintanasa/set-notification-position/refs/heads/main/LICENSE.md"

checksum="7fac6a1ffb5311d8651d83caac625229d1715b5d1c0ef57c76fe52ad5bef653f
 addb1c67a9dc2334f5d3f5ee416451266cf040d787070903cca6b9d99d6331a3"

do_extract() {
	# Unzip the official .zip archive into the temporary working directory of xbps-src
	unzip -d ${wrksrc} ${XBPS_SRCDISTDIR}/${pkgname}-${version}/set-notification-positionbrgvos.v${version}.shell-extension.zip
	# Copy LICENSE
	cp ${XBPS_SRCDISTDIR}/${pkgname}-${version}/LICENSE.md ${wrksrc}/
}

do_install() {
	# Local variables
	local uuid="set-notification-position@brgvos"
	local extdir="usr/share/gnome-shell/extensions/${uuid}"

	# 1. Install License
	vlicense LICENSE.md

	# 2. Create the global system extensions path inside the package
	vmkdir "${extdir}"
	
	# 3. Copy all files extracted from zip directly to system destination
	vcopy "*" "${extdir}"

	# 4. Make clean
	rm -f "${DESTDIR}/${extdir}/LICENSE.md"

	# 5. Ensure schemas directory exists (required for compilation)
	vmkdir "${extdir}/schemas"

	# 6. Fix the rights - eliminate the written right
	find "${DESTDIR}/${extdir}" -type f -exec chmod 644 {} +
	find "${DESTDIR}/${extdir}" -type d -exec chmod 755 {} +
}
