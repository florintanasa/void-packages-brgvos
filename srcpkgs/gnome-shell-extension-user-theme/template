# Template file for 'gnome-shell-extension-user-theme'
pkgname=gnome-shell-extension-user-theme
version=64
revision=1
hostmakedepends="unzip"
depends="gnome-shell glib"
short_desc="Load shell themes from user directory"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://extensions.gnome.org"
distfiles="${homepage}/extension-data/user-themegnome-shell-extensions.gcampax.github.com.v${version}.shell-extension.zip"

checksum="bd8cda948665101960044269d78d0858447f491dc38d875fda77aaec735bf72c"

do_extract() {
	# Unzip the official .zip archive into the temporary working directory of xbps-src
	unzip -d ${wrksrc} ${XBPS_SRCDISTDIR}/${pkgname}-${version}/user-themegnome-shell-extensions.gcampax.github.com.v${version}.shell-extension.zip
}

do_install() {
	# The exact UUID used in the BRGV-OS distribution
	local uuid="user-theme@gnome-shell-extensions.gcampax.github.com"
	local extdir="usr/share/gnome-shell/extensions/${uuid}"

	# 1. Create the global system extensions path inside the package
	vmkdir "${extdir}"
	
	# 2. Copy all files extracted from zip directly to system destination
	vcopy "*" "${extdir}"

	# 3. Ensure schemas directory exists (required for compilation)
	vmkdir "${extdir}/schemas"
}
