# Template for 'materialcraft'
pkgname=materialcraft
version=0.1.0
revision=1
build_style=cargo
make_build_args="-p materialcraft -p materialcraft-cli"
hostmakedepends="pkg-config"
short_desc="Fast, open-source node-based material designer app built in pure Rust"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="Apache-2.0, MIT"
homepage="https://getartcraft.com/apps/materialcraft"

distfiles="https://github.com/storytold/materialcraft/archive/refs/tags/v${version}.tar.gz"

checksum=8cbcbf68199fbb3a472d47e06253b62912da814f8eb923901211ad5ba7133c96

do_install() {
	# 1. Install application binaries directly from target release (prevents double compilation)
	vbin target/${RUST_TARGET}/release/materialcraft
	vbin target/${RUST_TARGET}/release/materialcraft-cli

	# 2. Install desktop shortcut, appstream metadata, and custom mime types from upstream packaging
	if [ -d "packaging/linux" ]; then
		vinstall packaging/linux/ai.storyteller.materialcraft.desktop 644 usr/share/applications
		vinstall packaging/linux/ai.storyteller.materialcraft.mime.xml 644 usr/share/mime/packages ai.storyteller.materialcraft.xml
		vinstall packaging/linux/ai.storyteller.materialcraft.metainfo.xml.in 644 usr/share/metainfo ai.storyteller.materialcraft.metainfo.xml
	fi

	# 3. Iterate over the standard hicolor icon paths and install them with the proper app ID name
	local size
	for size in 16x16 24x24 32x32 48x48 64x64 128x128 256x256 512x512; do
		if [ -f "assets/app-icon/hicolor/${size}/apps/ai.storyteller.materialcraft.png" ]; then
			vinstall "assets/app-icon/hicolor/${size}/apps/ai.storyteller.materialcraft.png" \
				644 "usr/share/icons/hicolor/${size}/apps"
		fi
	done

	if [ -f "assets/app-icon/hicolor/scalable/apps/ai.storyteller.materialcraft.svg" ]; then
		vinstall "assets/app-icon/hicolor/scalable/apps/ai.storyteller.materialcraft.svg" \
			644 "usr/share/icons/hicolor/scalable/apps"
	fi

	# 4. Install standard software licenses and the legal NOTICE file
	vlicense LICENSE-APACHE
	vlicense LICENSE-MIT
	if [ -f "NOTICE" ]; then
		vlicense NOTICE
	fi

	# 5. Extract and bundle technical Markdown documentation
	if [ -d "docs" ]; then
		local docfile
		for docfile in docs/*.md; do
			if [ -f "$docfile" ]; then
				vdoc "$docfile"
			fi
		done
	fi

	# 6. Some corrections
	vsed -i 's|^StartupWMClass=.*|StartupWMClass=MaterialCraft|g' ${DESTDIR}/usr/share/applications/ai.storyteller.materialcraft.desktop
}
