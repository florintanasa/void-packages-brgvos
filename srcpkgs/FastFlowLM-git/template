# Template file for 'FastFlowLM-git'
pkgname=FastFlowLM-git
version=2026.10.29.0
revision=1
_branch=main
_commit=f37cdd29edc777cf3db1e385da8e7bfadc57d0b3
build_style=cmake
hostmakedepends="cmake pkg-config git cargo rust"
makedepends="boost-devel xdna-driver-xrt-git libcurl-devel fftw-devel ffmpeg6-devel libuuid-devel libdrm-devel libgomp-devel readline-devel libedit-devel"
depends="xdna-driver-git xdna-driver-xrt-git"
short_desc="Fast LLM inference engine optimized for AMD XDNA NPU from git"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="MIT"
homepage="https://github.com/FastFlowLM/FastFlowLM"

do_fetch() {
	:
}

do_extract() {
	mkdir -p "${XBPS_BUILDDIR}"
	cd "${XBPS_BUILDDIR}"
	git clone --recursive https://github.com/FastFlowLM/FastFlowLM -b ${_branch} ${pkgname}-${version}
	cd ${pkgname}-${version}
	git switch --detach ${_commit}
}

wrksrc="${pkgname}-${version}"

do_configure() {
	cd src

	export CFLAGS="-march=x86-64-v4 -O3 ${CFLAGS}"
	export CXXFLAGS="-march=x86-64-v4 -O3 ${CXXFLAGS}"
	export RUSTFLAGS="-C target-cpu=x86-64-v4 -C opt-level=3"

	cmake --preset linux-default \
		-DCMAKE_BUILD_TYPE=Release \
		-DUSE_XDNA=ON \
		-DFLM_BUILD_GEMMA4E=ON \
		-DXRT_ROOT=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_PREFIX=/usr
}

do_build() {
	cd src
	cmake --build --preset linux-default --parallel ${XBPS_MAKEJOBS}
}

do_install() {
	cd src
	
	# Preset-ul linux-default on src/build
	DESTDIR="${DESTDIR}" cmake --install build

	vlicense "../assets/superseded/LICENSE_BINARY.txt"
	vlicense "../LICENSE_RUNTIME.txt"
}

