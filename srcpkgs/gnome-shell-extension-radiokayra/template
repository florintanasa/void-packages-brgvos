# Template file for 'gnome-shell-radiokayra'
pkgname=gnome-shell-extension-radiokayra
version=7
revision=1
hostmakedepends="unzip"
depends="gnome-shell glib"
short_desc="A tray radio extension to listen, search and manage radio stations, Youtube videos"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="GPL-3.0"
homepage="https://extensions.gnome.org"
distfiles="${homepage}/extension-data/radiokayradokaton.com.v${version}.shell-extension.zip
 https://raw.githubusercontent.com/ayhanavci/radiokayra/refs/heads/main/LICENCE.txt"

checksum="b45fc3892bdc8fdea3f660423501dd80fc0cb51fdb9c7d2b96924009250f87c3
 3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"

do_extract() {
	# Unzip the official .zip archive into the temporary working directory of xbps-src
	unzip -d ${wrksrc} ${XBPS_SRCDISTDIR}/${pkgname}-${version}/radiokayradokaton.com.v${version}.shell-extension.zip
	# Copy LICENSE
	cp ${XBPS_SRCDISTDIR}/${pkgname}-${version}/LICENCE.txt ${wrksrc}/
}

do_install() {
	# Local variables
	local uuid="adiokayra@dokaton.com"
	local extdir="usr/share/gnome-shell/extensions/${uuid}"

	# 1. Install License
	vlicense LICENCE.txt

	# 2. Create the global system extensions path inside the package
	vmkdir "${extdir}"
	
	# 3. Copy all files extracted from zip directly to system destination
	vcopy "*" "${extdir}"

	# 4. Make clean
	rm -f "${DESTDIR}/${extdir}/LICENCE.txt"

	# 5. Ensure schemas directory exists (required for compilation)
	vmkdir "${extdir}/schemas"
}
