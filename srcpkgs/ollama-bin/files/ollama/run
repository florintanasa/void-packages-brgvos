#!/bin/sh
# Runit service for Ollama in BRGV-OS

# Redirect standard errors to the system log
exec 2>&1

# FORCE SYSTEM LIMITS FOR LLM HARDWARE ACCELERATION (Runit bypasses PAM/limits.d)
ulimit -Sl unlimited
ulimit -Hl unlimited

# Load drop-in configurations sequentially from /etc/ollama/conf.d
if [ -d /etc/ollama/conf.d ]; then
	for f in /etc/ollama/conf.d/*.conf; do
		[ -r "$f" ] && . "$f"
	done
fi

# Point to the official global paths where XBPS extracted the ROCm libraries
export LD_LIBRARY_PATH="/usr/lib:/usr/lib64:/usr/lib/ollama:/usr/lib/ollama/rocm_v7_2:$LD_LIBRARY_PATH"

# Force Ollama to generate its configuration keys and cache inside its own secure directory
export HOME="/var/lib/ollama"
export XDG_CACHE_HOME="/var/lib/ollama/.cache"

# REDIRECT OLLAMA BLOB STORAGE TO THE UNIFIED REPOSITORY SUBFOLDER
export OLLAMA_MODELS="/var/lib/llms/ollama"

# Verify the existence of the working directory before execution
cd /var/lib/ollama || exit 1

# Launch the isolated server under the designated user and supplementary groups
exec chpst -u ollama:ollama:video:llm /usr/bin/ollama serve
