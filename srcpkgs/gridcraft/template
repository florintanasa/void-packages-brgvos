# Template for 'gridcraft'
pkgname=gridcraft
version=0.13.0
revision=1
build_style=cargo
make_build_args="-p gridcraft -p gridcraft-cli"
hostmakedepends="pkg-config"
short_desc="Fast, open-source spreadsheet and data analysis app built in pure Rust"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="Apache-2.0, MIT"
homepage="https://getartcraft.com/apps/gridcraft"

distfiles="https://github.com/storytold/gridcraft/archive/refs/tags/v${version}.tar.gz"

checksum="b33b6ab1f9032b0ccf6fbbe281affa618a325bf54030fa0d017a7fc1bf2f8251"

do_install() {
	# 1. Install application binaries directly from target release (prevents double compilation)
	vbin target/${RUST_TARGET}/release/gridcraft
	vbin target/${RUST_TARGET}/release/gridcraft-cli

	# 2. Install desktop shortcut, appstream metadata, and custom mime types from upstream packaging
	if [ -d "packaging/linux" ]; then
		vinstall packaging/linux/ai.storyteller.gridcraft.desktop 644 usr/share/applications
		vinstall packaging/linux/ai.storyteller.gridcraft.mime.xml 644 usr/share/mime/packages ai.storyteller.gridcraft.xml
		vinstall packaging/linux/ai.storyteller.gridcraft.metainfo.xml.in 644 usr/share/metainfo ai.storyteller.gridcraft.metainfo.xml
	fi

	# 3. Iterate over the standard hicolor icon paths and install them with the proper app ID name
	local size
	for size in 16x16 24x24 32x32 48x48 64x64 128x128 256x256 512x512; do
		if [ -f "assets/app-icon/hicolor/${size}/apps/ai.storyteller.gridcraft.png" ]; then
			vinstall "assets/app-icon/hicolor/${size}/apps/ai.storyteller.gridcraft.png" \
				644 "usr/share/icons/hicolor/${size}/apps"
		fi
	done

	if [ -f "assets/app-icon/hicolor/scalable/apps/ai.storyteller.gridcraft.svg" ]; then
		vinstall "assets/app-icon/hicolor/scalable/apps/ai.storyteller.gridcraft.svg" \
			644 "usr/share/icons/hicolor/scalable/apps"
	fi

	# 4. Install standard software licenses and the legal NOTICE file
	vlicense LICENSE-APACHE
	vlicense LICENSE-MIT
	if [ -f "NOTICE" ]; then
		vlicense NOTICE
	fi

	# 5. Extract and bundle technical Markdown documentation
	if [ -d "docs" ]; then
		local docfile
		for docfile in docs/*.md; do
			if [ -f "$docfile" ]; then
				vdoc "$docfile"
			fi
		done
	fi
}
