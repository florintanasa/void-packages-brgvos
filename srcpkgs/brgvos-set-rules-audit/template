skip_extraction=yes
nostrip=yes
noverifyrdeps=yes

do_install() {
	# Force destination tree structure creation before unpacking archive stream
	vmkdir usr/share

	# REPACKAGING TRANSLATION LAYER:
	# Uses GNU tar sed-expression transform to dynamically rewrite usr/local/share paths
	# into compliance-friendly system-wide usr/bin destinations on the fly.
	tar -C "$DESTDIR" --transform='s|^usr/local/|usr/|' -xzf ${XBPS_SRCDISTDIR}/${pkgname}-${version}/brgvos-set-rules-audit.tar.gz

	# This ensures files get secure 644 flags while directory nodes retain 755 structures.
	if [ -d "${DESTDIR}/usr/share" ]; then
		find "${DESTDIR}/usr/share" -type d -exec chmod 755 {} +
		find "${DESTDIR}/usr/share" -type f -exec chmod 644 {} +
	fi
}
