pkgname=brgvos-set-theme-scripts
version=1.0
revision=1
hostmakedepends="tar"
short_desc="BRGVOS theme setting scripts and desktop entries"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="GPL-3.0-or-later"
