#distfiles="https://github.com/florintanasa/brgvos-void/releases/download/v${version}/brgvos-set-theme-scripts.tar.gz"
distfiles="https://github.com/florintanasa/brgvos-void/raw/refs/heads/work/files/includedir/brgvos-set-theme-scripts.tar.gz"
checksum="ade7ef01ac95c14d8f4022045a0e3fdd6f1d6d2f23bef8fd425390cdbdd8469b"
# TODO: create GitHub release v${version} on florintanasa/brgvos-void and attach brgvos-set-theme-scripts.tar.gz
#       (archive generated by the matching files/includedir/brgvos-*.sh script).
skip_extraction=yes
nostrip=yes
noverifyrdeps=yes

do_install() {
	# Force destination tree structure creation before unpacking archive stream
	vmkdir usr/bin
	vmkdir usr/share

	# REPACKAGING TRANSLATION LAYER:
	# Uses GNU tar sed-expression transform to dynamically rewrite usr/local paths
	# into compliance-friendly system-wide usr/bin and usr/share destinations on the fly.
	tar -C "$DESTDIR" --transform='s|^usr/local/|usr/|' -xzf ${XBPS_SRCDISTDIR}/${pkgname}-${version}/brgvos-set-theme-scripts.tar.gz

	# This ensures files get secure 644 flags while directory nodes retain 755 structures.
	if [ -d "${DESTDIR}/usr/share" ]; then
		find "${DESTDIR}/usr/share" -type d -exec chmod 755 {} +
		find "${DESTDIR}/usr/share" -type f -exec chmod 644 {} +
	fi
	# Ensure that permissions are cleanly set to standard UNIX execution masks
	if [ -d "${DESTDIR}/usr/bin" ]; then
		chmod 755 ${DESTDIR}/usr/bin/*
	fi
}
