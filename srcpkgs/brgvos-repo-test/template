# Template file for 'brgvos-repo-test'
# Content is packaged from the brgvos-includedir category archives in the brgvos-void repo.
pkgname=brgvos-repo-test
version=1.0
revision=1
hostmakedepends="tar"
short_desc="BRGVOS xbps repository configuration"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/florintanasa/brgvos-void"
#distfiles="https://github.com/florintanasa/brgvos-void/releases/download/v${version}/brgvos-repo-test.tar.gz"
distfiles="https://github.com/florintanasa/brgvos-void/raw/refs/heads/work/files/includedir/brgvos-repo-test.tar.gz"
checksum="d2261c9272481b2fe9ad7adc12abc93406f5fd99e8c9e123df3b55c66b04cfcd"
# TODO: create GitHub release v${version} on florintanasa/brgvos-void and attach brgvos-repo-test.tar.gz
#       (archive generated by the matching files/includedir/brgvos-*.sh script).
skip_extraction=yes
nostrip=yes
noverifyrdeps=yes

do_install() {
	tar -C "$DESTDIR" -xzf ${XBPS_SRCDISTDIR}/${pkgname}-${version}/brgvos-repo-test.tar.gz
	# This ensures files get secure 644 flags while directory nodes retain 755 structures.
	if [ -d "${DESTDIR}/usr/share" ]; then
		find "${DESTDIR}/usr/share" -type d -exec chmod 755 {} +
		find "${DESTDIR}/usr/share" -type f -exec chmod 644 {} +
	fi
}
