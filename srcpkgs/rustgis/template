# Template for 'rustgis'
pkgname=rustgis
version=0.6.0
revision=1
build_style=cargo
make_build_args="-p rustgis -p rustgis-cli"
hostmakedepends="pkg-config"
makedepends="libzstd-devel sqlite-devel"
short_desc="Fast, open-source GIS app built in pure Rust"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="Apache-2.0"
homepage="https://rustgis.app/"

distfiles="https://github.com/opengeos/RustGIS/archive/refs/tags/v${version}.tar.gz
 https://assets.rustgis.app/data/countries.geojson>countries.geojson
 https://assets.rustgis.app/data/countries_chn.geojson>countries_chn.geojson
 https://assets.rustgis.app/data/cities.geojson>cities.geojson
 https://assets.rustgis.app/data/rivers.geojson>rivers.geojson
 https://assets.rustgis.app/data/lakes.geojson>lakes.geojson"

checksum="60850a7dd447644fe9c75693ababe6784ae38db550dec9d8dafc5fad305e1c0d
 bef8ee61e46685049d47b577b86fb76e9f67af41a3d4c38acb67f0021bf31b36
 5248ed3c99667a348a8f14f86c272508d18473fe188d8ac3a4e780ec913fc2ea
 28c87845799741b198122a3e9ab2b1a14a1504eb74187aaf1db0d3af8a758b1e
 897111f4b3f2bddc98c78993b848d1ad18ceb90bbb3ec9d703888c90edf70e73
