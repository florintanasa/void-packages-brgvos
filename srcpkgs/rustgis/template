skip_extraction="countries.geojson countries_chn.geojson cities.geojson rivers.geojson lakes.geojson"

pre_build() {
	export RUSTGIS_DATA_DIR="${XBPS_SRCDISTDIR}/${pkgname}-${version}"
}

do_install() {
	# 1. Install application binaries directly from target release (prevents double compilation)
	vbin target/${RUST_TARGET}/release/rustgis
	vbin target/${RUST_TARGET}/release/rustgis-cli

	# 2. Install desktop shortcut, appstream metadata, and custom mime types from upstream packaging
	if [ -d "packaging/linux" ]; then
		vinstall packaging/linux/rustgis.desktop 644 usr/share/applications
		vinstall packaging/linux/rustgis-mime.xml 644 usr/share/mime/packages rustgis.xml
	fi

	# 3. Install standard software licenses and the legal NOTICE file if exist
	vlicense LICENSE
	vlicense THIRD-PARTY-LICENSES.txt
	if [ -f "NOTICE" ]; then
		vlicense NOTICE
	fi

	# 4. Extract and bundle technical Markdown documentation
	if [ -d "docs" ]; then
		local docfile
		for docfile in docs/*.md; do
			if [ -f "$docfile" ]; then
				vdoc "$docfile"
			fi
		done
	fi
}

post_install() {
	# Build thne icons and then install
	local rustgis_cli="target/${RUST_TARGET}/release/rustgis-cli"

	for s in 32 64 128 256 512; do
		vmkdir "usr/share/icons/hicolor/${s}x${s}/apps"
		${rustgis_cli} logo "${DESTDIR}/usr/share/icons/hicolor/${s}x${s}/apps/rustgis.png" --size "$s"
	done
}