skip_extraction=yes
nostrip=yes
noverifyrdeps=yes

do_install() {
	# Force destination tree structure creation before unpacking archive stream
	vmkdir usr/bin

	# REPACKAGING TRANSLATION LAYER:
	# Uses GNU tar sed-expression transform to dynamically rewrite usr/local/bin paths
	# into compliance-friendly system-wide usr/bin destinations on the fly.
	tar -C "$DESTDIR" --transform='s|^usr/local/|usr/|' -xzf ${XBPS_SRCDISTDIR}/${pkgname}-${version}/brgvos-set-lang-scripts.tar.gz

	# Ensure that permissions are cleanly set to standard UNIX execution masks
	if [ -d "${DESTDIR}/usr/bin" ]; then
		chmod 755 ${DESTDIR}/usr/bin/*
	fi
}
