# Template file for 'gnome-shell-extension-tiling-assistant'
pkgname=gnome-shell-extension-tiling-assistant
version=54
revision=1
hostmakedepends="unzip"
depends="gnome-shell glib"
short_desc="Expand GNOME's 2 column tiling and add a Windows-snap-assist-inspired popup..."
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="GPL-2.0"
homepage="https://extensions.gnome.org"
distfiles="${homepage}/extension-data/tiling-assistantleleat-on-github.v${version}.shell-extension.zip
 https://raw.githubusercontent.com/ubuntu/Tiling-Assistant/refs/heads/main/LICENSE"

checksum="9b2b8ebc3eee5803d4f12b2f08b855303e91cebd70ff6d6aef3b1e7903920de1
 8177f97513213526df2cf6184d8ff986c675afb514d4e68a404010521b880643"

do_extract() {
	# Unzip the official .zip archive into the temporary working directory of xbps-src
	unzip -d ${wrksrc} ${XBPS_SRCDISTDIR}/${pkgname}-${version}/tiling-assistantleleat-on-github.v${version}.shell-extension.zip
	# Copy LICENSE
	cp ${XBPS_SRCDISTDIR}/${pkgname}-${version}/LICENSE ${wrksrc}/
}

do_install() {
	# Local variables
	local uuid="tiling-assistant@leleat-on-github"
	local extdir="usr/share/gnome-shell/extensions/${uuid}"

	# 1. Install License
	vlicense LICENSE

	# 2. Create the global system extensions path inside the package
	vmkdir "${extdir}"
	
	# 3. Copy all files extracted from zip directly to system destination
	vcopy "*" "${extdir}"

	# 4. Make clean
	rm -f "${DESTDIR}/${extdir}/LICENSE"

	# 5. Ensure schemas directory exists (required for compilation)
	vmkdir "${extdir}/schemas"
}
