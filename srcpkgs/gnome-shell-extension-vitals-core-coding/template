# Template file for 'gnome-shell-extension-vitals-core-coding'
pkgname=gnome-shell-extension-vitals-core-coding
version=82
revision=1
hostmakedepends="unzip"
depends="gnome-shell glib"
short_desc="A glimpse into your computer's temperature, voltage, fan speed, memory usage, processor load, system resources, network speed and storage stats"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="GPL-2.0"
homepage="https://extensions.gnome.org"
distfiles="${homepage}/extension-data/VitalsCoreCoding.com.v${version}.shell-extension.zip"

checksum="ebd5383ceac36e4db09c1034e5440f21491113a342e9ad957ed3b30bd50e2a67"

do_extract() {
	# Unzip the official .zip archive into the temporary working directory of xbps-src
	unzip -d ${wrksrc} ${XBPS_SRCDISTDIR}/${pkgname}-${version}/VitalsCoreCoding.com.v${version}.shell-extension.zip
}

do_install() {
	# The exact UUID used in the BRGV-OS distribution
	local uuid="Vitals@CoreCoding.com"
	local extdir="usr/share/gnome-shell/extensions/${uuid}"

	# 1. Create the global system extensions path inside the package
	vmkdir "${extdir}"
	
	# 2. Copy all files extracted from zip directly to system destination
	vcopy "*" "${extdir}"

	# 3. Ensure schemas directory exists (required for compilation)
	vmkdir "${extdir}/schemas"
}