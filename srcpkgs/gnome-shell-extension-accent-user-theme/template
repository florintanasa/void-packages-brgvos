# Template file for 'gnome-shell-extension-accent-user-theme'
pkgname=gnome-shell-extension-accent-user-theme
version=3
revision=1
hostmakedepends="unzip"
depends="gnome-shell glib gnome-shell-extension-user-theme"
short_desc="Makes user themes to follow system accent color and color scheme Light or Dark"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://extensions.gnome.org"
distfiles="${homepage}/extension-data/accent-user-themebrgvos.v${version}.shell-extension.zip
 https://raw.githubusercontent.com/florintanasa/accent-user-theme/refs/heads/main/LICENSE.md"

checksum="738911893fe13caba245991241947544f62de7a2393619d233d74dca949ecd29
 addb1c67a9dc2334f5d3f5ee416451266cf040d787070903cca6b9d99d6331a3"

do_extract() {
	# Unzip the official .zip archive into the temporary working directory of xbps-src
	unzip -d ${wrksrc} ${XBPS_SRCDISTDIR}/${pkgname}-${version}/accent-user-themebrgvos.v${version}.shell-extension.zip
	# Copy LICENSE.md
	cp ${XBPS_SRCDISTDIR}/${pkgname}-${version}/LICENSE.md ${wrksrc}/
}

do_install() {
	# Local variables
	local uuid="accent-user-theme@brgvos"
	local extdir="usr/share/gnome-shell/extensions/${uuid}"

	# 1. Install License
	vlicense LICENSE.md

	# 2. Create the global system extensions path inside the package
	vmkdir "${extdir}"
	
	# 3. Copy all files extracted from zip directly to system destination
	vcopy "*" "${extdir}"

	# 4. Make clean
	rm -f "${DESTDIR}/${extdir}/LICENSE.md"

	# 5. Ensure schemas directory exists (required for compilation)
	vmkdir "${extdir}/schemas"
}
