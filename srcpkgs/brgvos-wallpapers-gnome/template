# Template file for 'brgvos-wallpapers-gnome'
# Content is packaged from the brgvos-includedir category archives in the brgvos-void repo.
pkgname=brgvos-wallpapers-gnome
version=1.0
revision=1
hostmakedepends="tar"
short_desc="BRGVOS GNOME wallpapers and backgrounds"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/florintanasa/brgvos-void"
#distfiles="https://github.com/florintanasa/brgvos-void/releases/download/v${version}/brgvos-wallpapers-gnome.tar.gz"
distfiles="https://github.com/florintanasa/brgvos-void/raw/refs/heads/work/files/includedir/brgvos-wallpapers-gnome.tar.gz"

checksum="bf5b3e26f92a181be66f7823f74656b3cd0ca8de95d6fb5453fb1c7286da9ff2"
# TODO: create GitHub release v${version} on florintanasa/brgvos-void and attach brgvos-wallpapers-gnome.tar.gz
#       (archive generated by the matching files/includedir/brgvos-*.sh script).
skip_extraction=yes
nostrip=yes
noverifyrdeps=yes

do_install() {
	tar -C "$DESTDIR" -xzf ${XBPS_SRCDISTDIR}/${pkgname}-${version}/brgvos-wallpapers-gnome.tar.gz

	# This ensures files get secure 644 flags while directory nodes retain 755 structures.
	if [ -d "${DESTDIR}/usr/share" ]; then
		find "${DESTDIR}/usr/share" -type d -exec chmod 755 {} +
		find "${DESTDIR}/usr/share" -type f -exec chmod 644 {} +
	fi
}
