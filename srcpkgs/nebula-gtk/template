# Template file for 'nebula-gtk'
pkgname=nebula-gtk
version=1.3.7
revision=1
build_style=cargo
configure_args="--bin nebula-gtk"
hostmakedepends="pkg-config"
makedepends="gtk4-devel libadwaita-devel glib-devel pango-devel"
depends="dbus polkit xbps"
short_desc="GTK4/Libadwaita software center frontend for XBPS"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="MIT"
homepage="https://github.com/Letdown2491/nebula-gtk"
changelog="https://raw.githubusercontent.com/Letdown2491/nebula-gtk/refs/heads/main/CHANGELOG.md"
distfiles="${homepage}/archive/refs/tags/v${version}.tar.gz"

checksum="f15c55a486f23d16146e701f43d5406927d0ec559fd3efe2adc61c0f42576b14"

pre_build() {
	# Generate the Cargo.lock file to bypass strict --locked restrictions
	cargo generate-lockfile
}

do_install() {
	# 1. Install application launcher file
	vinstall assets/applications/tech.geektoshi.Nebula.desktop 644 usr/share/applications

	# 2. Install hicolor raster and vector icons
	for size in 128x128 256x256 512x512; do
		vinstall "assets/icons/hicolor/${size}/apps/nebula.png" 644 "usr/share/icons/hicolor/${size}/apps"
	done

	# 3. Install metadata category structural components
	vinstall data/generated/category_suggestions.json 644 usr/share/nebula-gtk

	# 4. Install target release architecture binaries into secure libexec
	vmkdir usr/libexec
	vinstall "target/${RUST_TARGET}/release/nebula-gtk" 755 usr/libexec

	# 5. Create user terminal path shortcut symlink into system PATH
	vmkdir usr/bin
	ln -sf /usr/libexec/nebula-gtk ${DESTDIR}/usr/bin/nebula-gtk

	# 6. Install system documentation and upstream license matrices
	vdoc README.md
	vlicense LICENSE
}
