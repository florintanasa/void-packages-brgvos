# Template file for 'agrossuite'
pkgname=agrossuite
version=2025.03.03.0
revision=1
_commit="13a7f69617c7831fd5e300943e6a6578df294ed7"
build_style=cmake
configure_args="-DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr"
hostmakedepends="cmake pkg-config git qt6-tools-devel xsd-bin libxsd python3-Cython python3-scikit-build"
makedepends="qt6-base-devel qt6-qt5compat-devel qt6-svg-devel qt6-charts-devel
 libcurl-devel python3-devel python3-numpy libxerces-c-devel mumps-seq-devel xsd-bin libxsd SuiteSparse-devel"
depends="python3-numpy libxsd"
short_desc="Professional FEM (Finite Element Method) application suite with Python bindings"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://www.agros2d.org/web/"
distfiles="https://github.com/artap-framework/agrossuite"

# Register internal private libraries
shlib_provides="libagros_3rdparty_nlopt2.so libagros_3rdparty_ctemplate.so libagros_3rdparty_dxflib.so libagros_3rdparty_matio.so libagros_3rdparty_quazip.so libagros_3rdparty_triangle.so"


do_fetch() {
	:
}

wrksrc="${pkgname}-${version}"

do_extract() {
	cd ${XBPS_BUILDDIR}
	git clone --recursive ${distfiles} ${pkgname}-${version}
	cd ${pkgname}-${version}
	git checkout ${_commit}
	git submodule update --init --recursive
}

pre_configure() {
	# 1. Build bundled dealii library
	cd ${wrksrc}/dealii
	mkdir -p build && cd build
	cmake -DCMAKE_BUILD_TYPE="Release" -DCMAKE_CXX_FLAGS="-I/usr/include/mumps" -DDEAL_II_FORCE_BUNDLED_BOOST="ON" ..
	make ${makejobs}

	# 2. Copy dealii shared objects to main build tree
	cd ${wrksrc}
	mkdir -p build/usr/lib
	cp -f dealii/build/lib/libdeal_II.so* build/usr/lib/

	# 3. Create compatibility link for mumps header
	mkdir -p build/include
	ln -sf /usr/include/mumps/dmumps_c.h build/include/mumps_c.h

	# 4. Patch FindMUMPS.cmake to use our monolithic mumps-seq layer
	echo 'SET(MUMPS_COMMON_LIBRARY "/usr/lib/libmumps_seq.so")' > solver-plugin-mumps/cmake/FindMUMPS.cmake
	echo 'SET(DMUMPS_LIBRARY "/usr/lib/libmumps_seq.so")' >> solver-plugin-mumps/cmake/FindMUMPS.cmake
	echo 'SET(MUMPS_LIBRARIES "/usr/lib/libmumps_seq.so")' >> solver-plugin-mumps/cmake/FindMUMPS.cmake
	echo 'SET(MUMPS_INCLUDE_DIR "/usr/include/mumps")' >> solver-plugin-mumps/cmake/FindMUMPS.cmake
	echo 'SET(MUMPS_FOUND TRUE)' >> solver-plugin-mumps/cmake/FindMUMPS.cmake

	# Comment out the rigid XSD version mismatch check
	vsed -i 's|#error XSD runtime version mismatch|// #error XSD runtime version mismatch|' resources_source/classes/module_xml.h

	# CRITIC COMPATIBILITY FIXES FOR SCIKIT-BUILD:
	# Inject the agros-library directory path directly into the standalone python CMake configuration
	vsed -i "s|INCLUDE_DIRECTORIES(\"\${CMAKE_SOURCE_DIR}/../../../agros-library\")|INCLUDE_DIRECTORIES(\"\${CMAKE_SOURCE_DIR}/../../../agros-library\")\nINCLUDE_DIRECTORIES(\"${wrksrc}/agros-library\")|" agros-python/agrossuite/CMakeLists.txt
}

post_build() {
	# 5. Execute compiled generator binary to build physics fields structure
	cd ${wrksrc}/build
	./usr/bin/agros_generator

	# 6. Compile solver plugins now that fields are generated
	cd plugins
	cmake -DCMAKE_BUILD_TYPE="Release" \
	      -DCMAKE_CXX_FLAGS="-I/usr/include/suitesparse" .
	make ${makejobs}

	# 7. CRITIC HARVESTING: Gather all compiled 3rdparty libraries BEFORE installation masks them
	# We stash them safely inside an independent folder within wrksrc
	msg_normal "Stashing all internal 3rdparty libraries...\n"
	mkdir -p ${wrksrc}/stashed_libs
	find ${wrksrc}/build/3rdparty -type f \( -name "*.so*" -o -name "*.a" \) | while read -r lib; do
		if [ -f "$lib" ]; then
			cp -f "$lib" ${wrksrc}/stashed_libs/
		fi
	done

	# 8. Expose the compiled library to the python setup environment
	mkdir -p ${wrksrc}/usr/lib
	cp -f ${wrksrc}/build/usr/lib/libagros_python.so ${wrksrc}/usr/lib/

	# 9. Clean up old build cache to force the new flags rewrite
	cd ${wrksrc}/agros-python/agrossuite
	rm -rf _skbuild

	# 10. Create the absolute paths fallback for pygeometry.h coordination
	mkdir -p _skbuild/linux-x86_64-3.14/cmake-build/src/agros-python
	ln -sf ${wrksrc}/agros-python/pythonlab _skbuild/linux-x86_64-3.14/cmake-build/src/agros-python/pythonlab

	# 11. Finalize compilation with all core header topologies explicitly injected
	msg_normal "Building Python extensions with enforced paths...\n"
	_bundled_flags="-I${wrksrc}/dealii/bundled/kokkos-3.7.00/core/src -I${wrksrc}/dealii/bundled/kokkos-3.7.00/tpls/desul/include -I${wrksrc}/dealii/bundled/boost-1.70.0/include -I${wrksrc}/dealii/bundled/tbb-2018_U2/include"
	_3rdparty_flags="-I${wrksrc}/3rdparty/bayesopt/include -I${wrksrc}/3rdparty/nlopt2/src/api -I${wrksrc}/3rdparty/poly2tri -I${wrksrc}/3rdparty/quazip -I${wrksrc}/3rdparty/libdxfrw"
	_system_flags="-I/usr/include/suitesparse"
	
	CXXFLAGS="${CXXFLAGS} -I${wrksrc} -I${wrksrc}/agros-library -I${wrksrc}/3rdparty ${_3rdparty_flags} -I${wrksrc}/dealii/include -I${wrksrc}/dealii/build/include ${_bundled_flags} ${_system_flags}" \
	CFLAGS="${CFLAGS} -I${wrksrc} -I${wrksrc}/agros-library -I${wrksrc}/3rdparty ${_3rdparty_flags} -I${wrksrc}/dealii/include -I${wrksrc}/dealii/build/include ${_bundled_flags} ${_system_flags}" \
	python3 setup.py build
}

pre_install() {
	# Neutralize the rigid third-party install scripts to bypass faulty file installations
	# All core application binaries are already linked, making these side rules redundant
	_nlopt_install="${wrksrc}/build/3rdparty/nlopt2/cmake_install.cmake"
	_pagmo_install="${wrksrc}/build/3rdparty/pagmo2/cmake_install.cmake"

	if [ -f "${_nlopt_install}" ]; then
		msg_normal "Bypassing rigid nlopt2 installation rules...\n"
		echo "# Slipped by BRGV-OS" > "${_nlopt_install}"
	fi

	if [ -f "${_pagmo_install}" ]; then
		msg_normal "Bypassing rigid pagmo2 installation rules...\n"
		echo "# Slipped by BRGV-OS" > "${_pagmo_install}"
	fi
}

post_install() {
	# 12. Install bundled dealii shared objects properly using vinstall
	vmkdir usr/lib
	for lib in ${wrksrc}/dealii/build/lib/libdeal_II.so*; do
		if [ -f "$lib" ]; then
			vinstall "$lib" 755 usr/lib
		fi
	done

	# 13. CRITIC DEPLOY: Install the stashed 3rdparty libraries directly from our safe vault
	msg_normal "Deploying stashed internal 3rdparty libraries to /usr/lib...\n"
	if [ -d "${wrksrc}/stashed_libs" ]; then
		for lib in ${wrksrc}/stashed_libs/*; do
			if [ -f "$lib" ]; then
				vinstall "$lib" 755 usr/lib
			fi
		done
	fi

	# 14. Install Python module package extensions natively from the subdirectory
	cd ${wrksrc}/agros-python/agrossuite
	_bundled_flags="-I${wrksrc}/dealii/bundled/kokkos-3.7.00/core/src -I${wrksrc}/dealii/bundled/kokkos-3.7.00/tpls/desul/include -I${wrksrc}/dealii/bundled/boost-1.70.0/include -I${wrksrc}/dealii/bundled/tbb-2018_U2/include"
	_3rdparty_flags="-I${wrksrc}/3rdparty/bayesopt/include -I${wrksrc}/3rdparty/nlopt2/src/api -I${wrksrc}/3rdparty/poly2tri -I${wrksrc}/3rdparty/quazip -I${wrksrc}/3rdparty/libdxfrw"
	_system_flags="-I/usr/include/suitesparse"
	
	CXXFLAGS="${CXXFLAGS} -I${wrksrc} -I${wrksrc}/agros-library -I${wrksrc}/3rdparty ${_3rdparty_flags} -I${wrksrc}/dealii/include -I${wrksrc}/dealii/build/include ${_bundled_flags} ${_system_flags}" \
	CFLAGS="${CFLAGS} -I${wrksrc} -I${wrksrc}/agros-library -I${wrksrc}/3rdparty ${_3rdparty_flags} -I${wrksrc}/dealii/include -I${wrksrc}/dealii/build/include ${_bundled_flags} ${_system_flags}" \
	python3 setup.py install --root=${DESTDIR} --optimize=1

	# 15. Install the desktop launcher menu shortcut natively into the target tree
	vinstall ${FILESDIR}/agrossuite.desktop 644 usr/share/applications

	# 16. Clean up any leaked asynchronous builddir ghosts from DESTDIR
	rm -rf "${DESTDIR}/builddir"
}

pre_pkg() {
	# FORCE PURGE 2: Safety net hook to guarantee 99-pkglint passes perfectly
	if [ -d "${DESTDIR}/builddir" ]; then
		msg_normal "Executing final emergency purge of pagmo2 leaked builddir...\n"
		rm -rf "${DESTDIR}/builddir"
	fi
}
