#!/bin/sh
# This script runs after the package files are unpacked on the target system
case "$1" in
post)
    echo "Compiling GSettings schemas for Dash To Dock..."
    if [ -d /usr/share/gnome-shell/extensions/dash-to-dock@micxgx.gmail.com/schemas ]; then
        glib-compile-schemas /usr/share/gnome-shell/extensions/dash-to-dock@micxgx.gmail.com/schemas
    fi
    ;;
esac
