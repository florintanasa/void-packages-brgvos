# Template file for 'gnome-shell-extension-dash-to-dock'
pkgname=gnome-shell-extension-dash-to-dock
version=105
revision=1
hostmakedepends="unzip"
depends="gnome-shell glib"
short_desc="A dock for the Gnome Shell"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="GPL-2.0"
homepage="https://extensions.gnome.org"
distfiles="${homepage}/extension-data/dash-to-dockmicxgx.gmail.com.v${version}.shell-extension.zip"

checksum="cf4a28a6488e81c9420362ad7954d7f585a47bc737d41ed0d713022fb04fa35f"

do_extract() {
	# Unzip the official .zip archive into the temporary working directory of xbps-src
	unzip -d ${wrksrc} ${XBPS_SRCDISTDIR}/${pkgname}-${version}/dash-to-dockmicxgx.gmail.com.v${version}.shell-extension.zip
}

do_install() {
	# The exact UUID used in the BRGV-OS distribution
	local uuid="dash-to-dock@micxgx.gmail.com"
	local extdir="usr/share/gnome-shell/extensions/${uuid}"

	# 1. Create the global system extensions path inside the package
	vmkdir "${extdir}"
	
	# 2. Copy all files extracted from zip directly to system destination
	vcopy "*" "${extdir}"

	# 3. Ensure schemas directory exists (required for compilation)
	vmkdir "${extdir}/schemas"
}
