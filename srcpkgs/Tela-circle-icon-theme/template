# Template file for 'Tela-circle-icon-theme'
pkgname=Tela-circle-icon-theme
version=0.1.0
revision=1
hostmakedepends="tar"
depends=""
short_desc="Tela circle icons suite for desktops - Base variations, fork from Vince(vinceliuice)"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="custom:"
homepage="https://github.com/florintanasa/Tela-circle-icon-theme"
distfiles="${homepage}/releases/download/v${version}/Tela-circle-icons-all.tar.gz"

checksum="71beb15a6343f355a4e65f96493a92ec430de359d1ce76ae8478937c6b40d918"

nostrip=yes
noverifyrdeps=yes

do_extract() {
	tar -xzf ${XBPS_SRCDISTDIR}/${pkgname}-${version}/Tela-circle-icons-all.tar.gz -C ${wrksrc}
}

do_install() {
	local icondir="usr/share/icons"
	vmkdir "${icondir}"

	# Install primary base theme components into main payload
	cp -a Tela-circle "${DESTDIR}/${icondir}/" 2>/dev/null || true
	cp -a Tela-circle-dark "${DESTDIR}/${icondir}/" 2>/dev/null || true
	cp -a Tela-circle-light "${DESTDIR}/${icondir}/" 2>/dev/null || true
}

Tela-circle-icon-theme-blue_package() {
	short_desc="Tela circle icons suite - Blue variations"
	nostrip=yes
	noverifyrdeps=yes
	pkg_install() {
		local icondir="usr/share/icons"
		vmkdir "${icondir}"
		cp -a ${wrksrc}/Tela-circle-blue "${PKGDESTDIR}/${icondir}/" 2>/dev/null || true
		cp -a ${wrksrc}/Tela-circle-blue-dark "${PKGDESTDIR}/${icondir}/" 2>/dev/null || true
		cp -a ${wrksrc}/Tela-circle-blue-light "${PKGDESTDIR}/${icondir}/" 2>/dev/null || true
	}
}

