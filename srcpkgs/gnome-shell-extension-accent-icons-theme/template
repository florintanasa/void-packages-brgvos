# Template file for 'gnome-shell-extension-accent-icons-theme'
pkgname=gnome-shell-extension-accent-icons-theme
version=4
revision=1
hostmakedepends="unzip"
depends="gnome-shell glib"
short_desc="Makes icons follow system accent color and color scheme Light or Dark"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://extensions.gnome.org"
distfiles="${homepage}/extension-data/accent-icons-themebrgvos.v${version}.shell-extension.zip"

checksum="b5da87b05e7f6772ccddf6e42c657aa0617d7dc9da03c6215a1a52db29415387"

do_extract() {
	# Unzip the official .zip archive into the temporary working directory of xbps-src
	unzip -d ${wrksrc} ${XBPS_SRCDISTDIR}/${pkgname}-${version}/accent-icons-themebrgvos.v${version}.shell-extension.zip
}

do_install() {
	# The exact UUID used in the BRGV-OS distribution
	local uuid="accent-icons-theme@brgvos"
	local extdir="usr/share/gnome-shell/extensions/${uuid}"

	# 1. Create the global system extensions path inside the package
	vmkdir "${extdir}"
	
	# 2. Copy all files extracted from zip directly to system destination
	vcopy "*" "${extdir}"

	# 3. Ensure schemas directory exists (required for compilation)
	vmkdir "${extdir}/schemas"
}
