# Template file for 'lemonade-server'
pkgname=lemonade-server
version=11.7.0
revision=2
_httplibver=0.53.1
build_style=cmake
configure_args="-G Ninja -D FETCHCONTENT_FULLY_DISCONNECTED=ON
 -D FETCHCONTENT_SOURCE_DIR_HTTPLIB=${XBPS_BUILDDIR}/${pkgname}-${version}/cpp-httplib-${_httplibver}"
hostmakedepends="pkg-config cmake ninja git nodejs"
makedepends="libwebsockets-devel openssl-devel libdrm-devel libzstd-devel json-c++ cli11 libcurl-devel mbedtls-devel"
depends="zstd unzip libwebsockets mbedtls"

# System accounts and isolation parameters
system_groups="llm"
system_accounts="lemonade"
lemonade_groups="video,llm"
lemonade_homedir="/var/lib/lemonade"
lemonade_shell="/sbin/nologin"

# Protect configuration files from being overwritten during package updates
conf_files="/etc/lemonade/conf.d/zz-secrets.conf /etc/lemonade/conf.d/lemonade.conf"

short_desc="Local LLM Serving with GPU and NPU acceleration using FastFlowLM and builtin backend (Server)"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="Apache-2.0"
homepage="https://github.com/lemonade-sdk/lemonade"

distfiles="${homepage}/archive/refs/tags/v${version}.tar.gz>lemonade-${version}.tar.gz
 https://github.com/yhirose/cpp-httplib/archive/refs/tags/v${_httplibver}.tar.gz>cpp-httplib-${_httplibver}.tar.gz"

checksum="395d688ba870afa5e71d3af4a6c3de9873632d2c2686663de7accc6435b6cbad
 185af9587e270de9a3bfee234c6740f02e82265da33c7a41f97e02ee42f979d2"

build_wrksrc="lemonade-${version}"

post_install() {
	# 1. Create service persistent directories and drop-in configurations path
	mkdir -p ${DESTDIR}/var/lib/lemonade/bin
	mkdir -p ${DESTDIR}/etc/lemonade/conf.d
	touch ${DESTDIR}/var/lib/lemonade/.keep_lemonade-server_0
	touch ${DESTDIR}/var/lib/lemonade/bin/.keep_lemonade-server_0

	# 2. Install the active configuration drop-in file (protected by conf_files)
	vinstall ${FILESDIR}/lemonade.conf 644 etc/lemonade/conf.d

	# 3. Prepare the central shared LLM repository structure within destdir
	mkdir -p ${DESTDIR}/var/lib/llms/huggingface
	mkdir -p ${DESTDIR}/var/lib/llms/flm
	touch ${DESTDIR}/var/lib/llms/huggingface/.keep_lemonade-server_0
	touch ${DESTDIR}/var/lib/llms/flm/.keep_lemonade-server_0

	# 4. Clean upstream systemd leftovers if generated by cmake
	rm -rf ${DESTDIR}/usr/lib/systemd

	# 5. Automatically install the runit service script from files/lemonade-server/run
	vsv lemonade-server
}
