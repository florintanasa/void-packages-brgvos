#!/bin/sh
# This script runs after the package files are unpacked on the target system
case "$1" in
post)
    echo "Setting the owner for lemonade directories..."
    chown -R lemonade:lemonade /var/lib/lemonade
    chown -R lemonade:lemonade /etc/lemonade
    chmod 750 /var/lib/lemonade /var/lib/lemonade/bin /etc/lemonade /etc/lemonade/conf.d

    echo "Ensuring central repository shared group mapping (non-recursive)..."
    chown root:llm /var/lib/llms /var/lib/llms/huggingface /var/lib/llms/flm
    chmod 2770 /var/lib/llms /var/lib/llms/huggingface /var/lib/llms/flm
    # Apply the working Default ACL directly to LLM's home
    if command -v setfacl >/dev/null 2>&1; then
        echo "Applying production Default ACLs for dynamic model sharing..."
        setfacl -d -m g:llm:rwX /var/lib/llms
        setfacl -d -m g:llm:rwX /var/lib/llms/huggingface
        setfacl -d -m g:llm:rwX /var/lib/llms/flm
    fi
    echo ""
    ;;
esac
