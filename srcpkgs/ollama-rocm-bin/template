distfiles="https://github.com/ollama/ollama/releases/download/v${version}/ollama-linux-amd64-rocm.tar.zst"

checksum=e41b4e45e5f83f65aa70ae01da3f9afdb1954bf4e1dd36f51d512e02082fac26

do_install() {
	mkdir -p ${DESTDIR}/usr
	tar -x --zstd -f ${XBPS_SRCDISTDIR}/${pkgname}-${version}/ollama-linux-amd64-rocm.tar.zst -C ${DESTDIR}/usr
}
