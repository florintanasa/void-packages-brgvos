# Template file for 'ollama-rocm-bin'
pkgname=ollama-rocm-bin
version=0.40.16
revision=1
archs="x86_64"
hostmakedepends="zstd tar"
depends="ollama>=0.24.0"
replaces="ollama-rocm<=7.2.70201_9"
nostrip=yes
allow_unknown_shlibs=yes
short_desc="AMD ROCm v7.2 acceleration runtime for Ollama"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
