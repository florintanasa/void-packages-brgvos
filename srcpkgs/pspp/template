# Template for 'pspp'
pkgname=pspp
version=2.1.2
revision=1
build_style=gnu-configure
# Force the build system to use 'true' if it ever attempts an internal automake loop
make_env="AUTOMAKE=true AM_MAKEFLAGS=PSPP_CONVERT=true"
configure_args="--without-libreadline-prefix --without-perl-module MAKEINFO=true"
hostmakedepends="pkg-config perl python3 gettext glib-devel texinfo"
# Mathematics, graphical backends (GTK3/SourceView), and database import headers
makedepends="gsl-devel gtk+3-devel gtksourceview4-devel cairo-devel pango-devel
 zlib-devel libxml2-devel spread-sheet-widget spread-sheet-widget-devel postgresql-libs-devel"
short_desc="Statistical analysis program and free replacement for SPSS"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://www.gnu.org/software/pspp/"
distfiles="https://mirrors.nav.ro/gnu/pspp/pspp-${version}.tar.gz"

checksum="042e08279679f4ab517d01d024115f7191eb4d0ade222c0ca296604406eeb3be"

pre_configure() {
	# Inject POSIX-fallback definitions for O_BINARY and O_TEXT to bypass strict fcntl checks
	export CFLAGS="${CFLAGS} -DO_BINARY=0 -DO_TEXT=0"
}

post_configure() {
	# 1. Inject the real pre-compiled images into the source tree BEFORE make runs.
	# This satisfies the build layout and guarantees the engine won't drop into loops.
	mkdir -p doc/pspp-figures
	cp -R ${FILESDIR}/pspp-figures/. doc/pspp-figures/

	# 2. Clear the input scripts just in case, ensuring absolute isolation from the Cairo loop
	find doc/ -type f -name "*.sps" -exec sh -c 'echo "" > "{}"' \;
	find doc/ -type f -name "*.grab" -exec sh -c 'echo "" > "{}"' \;
}

post_install() {
	# Install the built-in MIME data mapping file provided in the root directory
	vinstall org.gnu.pspp.xml 644 usr/share/mime/packages

	# Map and register baseline legal software licenses
	vlicense COPYING LICENSE
}
