# Template for 'texturecraft'
pkgname=texturecraft
version=0.3.0
revision=1
build_style=cargo
make_build_args="-p texturecraft -p texturecraft-cli"
hostmakedepends="pkg-config"
short_desc="Fast, open-source 3D texture painting workflow app built in pure Rust"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="Apache-2.0, MIT"
homepage="https://getartcraft.com/apps/texturecraft"

distfiles="https://github.com/storytold/texturecraft/archive/refs/tags/v${version}.tar.gz"

checksum=9a96daf045b172fb42273a5526772afc8cde37cf126017514f24763bbc885108

do_install() {
	# 1. Install application binaries directly from target release (prevents double compilation)
	vbin target/${RUST_TARGET}/release/texturecraft
	vbin target/${RUST_TARGET}/release/texturecraft-cli

	# 2. Install desktop shortcut, appstream metadata, and custom mime types from upstream packaging
	if [ -d "packaging/linux" ]; then
		vinstall packaging/linux/ai.storyteller.texturecraft.desktop 644 usr/share/applications
		vinstall packaging/linux/ai.storyteller.texturecraft.mime.xml 644 usr/share/mime/packages ai.storyteller.texturecraft.xml
		vinstall packaging/linux/ai.storyteller.texturecraft.metainfo.xml.in 644 usr/share/metainfo ai.storyteller.texturecraft.metainfo.xml
	fi

	# 3. Iterate over the standard hicolor icon paths and install them with the proper app ID name
	local size
	for size in 16x16 24x24 32x32 48x48 64x64 128x128 256x256 512x512; do
		if [ -f "assets/app-icon/hicolor/${size}/apps/ai.storyteller.texturecraft.png" ]; then
			vinstall "assets/app-icon/hicolor/${size}/apps/ai.storyteller.texturecraft.png" \
				644 "usr/share/icons/hicolor/${size}/apps"
		fi
	done

	if [ -f "assets/app-icon/hicolor/scalable/apps/ai.storyteller.texturecraft.svg" ]; then
		vinstall "assets/app-icon/hicolor/scalable/apps/ai.storyteller.texturecraft.svg" \
			644 "usr/share/icons/hicolor/scalable/apps"
	fi

	# 4. Install standard software licenses and the legal NOTICE file
	vlicense LICENSE-APACHE
	vlicense LICENSE-MIT
	if [ -f "NOTICE" ]; then
		vlicense NOTICE
	fi

	# 5. Extract and bundle technical Markdown documentation
	if [ -d "docs" ]; then
		local docfile
		for docfile in docs/*.md; do
			if [ -f "$docfile" ]; then
				vdoc "$docfile"
			fi
		done
	fi

	# 6. Some corrections
	vsed -i 's|^StartupWMClass=.*|StartupWMClass=TextureCraft|g' ${DESTDIR}/usr/share/applications/ai.storyteller.texturecraft.desktop
}
