# Template file for 'gnome-shell-extension-app-indicator'
pkgname=gnome-shell-extension-app-indicator
version=64
revision=1
hostmakedepends="unzip"
depends="gnome-shell glib"
short_desc="Adds AppIndicator, KStatusNotifierItem and legacy Tray icons support to the Shell"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="GPL-2.0"
homepage="https://extensions.gnome.org"
distfiles="${homepage}/extension-data/appindicatorsupportrgcjonas.gmail.com.v${version}.shell-extension.zip
 https://raw.githubusercontent.com/ubuntu/gnome-shell-extension-appindicator/refs/heads/master/LICENSE"

checksum="bce84ae9a2ea5daf3acfa2e5a8a706f818b0aa0bcd45b4127b2ab7b670fff94a
 8177f97513213526df2cf6184d8ff986c675afb514d4e68a404010521b880643"

do_extract() {
	# Unzip the official .zip archive into the temporary working directory of xbps-src
	unzip -d ${wrksrc} ${XBPS_SRCDISTDIR}/${pkgname}-${version}/appindicatorsupportrgcjonas.gmail.com.v${version}.shell-extension.zip
	# Copy LICENSE
	cp ${XBPS_SRCDISTDIR}/${pkgname}-${version}/LICENSE ${wrksrc}/
}

do_install() {
	# Local variables
	local uuid="appindicatorsupport@rgcjonas.gmail.com"
	local extdir="usr/share/gnome-shell/extensions/${uuid}"

	# 1. Install License
	vlicense LICENSE

	# 2. Create the global system extensions path inside the package
	vmkdir "${extdir}"
	
	# 3. Copy all files extracted from zip directly to system destination
	vcopy "*" "${extdir}"

	# 4. Make clean
	rm -f "${DESTDIR}/${extdir}/LICENSE"

	# 5. Ensure schemas directory exists (required for compilation)
	vmkdir "${extdir}/schemas"
}
