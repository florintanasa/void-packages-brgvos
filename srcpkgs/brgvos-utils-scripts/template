# Template file for 'brgvos-utils-scripts'
# Content is packaged from the brgvos-includedir category archives in the brgvos-void repo.
pkgname=brgvos-utils-scripts
version=1.0
revision=1
hostmakedepends="tar"
short_desc="BRGVOS utility scripts (openconn - list open connections)"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/florintanasa/brgvos-void"
#distfiles="https://github.com/florintanasa/brgvos-void/releases/download/v${version}/brgvos-utils-scripts.tar.gz"
distfiles="https://github.com/florintanasa/brgvos-void/raw/refs/heads/work/files/includedir/brgvos-utils-scripts.tar.gz"
checksum="c83301a0207ebb72b2513e8a813daff063a298be957f5d53cdaa64e74424edf4"
# TODO: create GitHub release v${version} on florintanasa/brgvos-void and attach brgvos-utils-scripts.tar.gz
#       (archive generated by the matching files/includedir/brgvos-*.sh script).
skip_extraction=yes
nostrip=yes
noverifyrdeps=yes

do_install() {
	# Force destination tree structure creation before unpacking archive stream
	vmkdir usr/bin

	# REPACKAGING TRANSLATION LAYER:
	# Uses GNU tar sed-expression transform to dynamically rewrite usr/local/bin paths
	# into compliance-friendly system-wide usr/bin destinations on the fly.
	tar -C "$DESTDIR" --transform='s|^usr/local/|usr/|' -xzf ${XBPS_SRCDISTDIR}/${pkgname}-${version}/brgvos-utils-scripts.tar.gz

	# Ensure that permissions are cleanly set to standard UNIX execution masks
	if [ -d "${DESTDIR}/usr/bin" ]; then
		chmod 755 ${DESTDIR}/usr/bin/*
	fi
}
