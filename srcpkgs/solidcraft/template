# Template file for 'solidcraft'
pkgname=solidcraft
version=0.30.1
revision=1
build_style=cargo
make_build_args="-p solidcraft -p solidcraft-cli"
hostmakedepends="pkg-config libzstd-devel"
short_desc="Open-source parametric 3D CAD application written in Rust"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="Apache-2.0, MIT"
homepage="https://solidcraft.io"
distfiles="https://github.com/tangency-labs/solidcraft/archive/refs/tags/v${version}.tar.gz"

checksum=@6627514c87c52d617593c4a8bc6aa7d7c265caa422a3fd9db6fa31233cbbb74c

do_install() {
	vbin target/${RUST_TARGET}/release/solidcraft
	vbin target/${RUST_TARGET}/release/solidcraft-cli

	if [ -d "assets/platforms/linux" ]; then
		vinstall assets/platforms/linux/io.tangencylabs.solidcraft.desktop 644 usr/share/applications
		vinstall assets/platforms/linux/io.tangencylabs.solidcraft.mime.xml 644 usr/share/mime/packages io.tangencylabs.solidcraft.xml
		vinstall assets/platforms/linux/io.tangencylabs.solidcraft.metainfo.xml.in 644 usr/share/metainfo io.tangencylabs.solidcraft.metainfo.xml
	fi

	local size
	for size in 16x16 24x24 32x32 48x48 64x64 128x128 256x256 512x512; do
		if [ -f "assets/icons/app/linux/exports/hicolor/${size}/apps/io.tangencylabs.solidcraft.png" ]; then
			vinstall "assets/icons/app/linux/exports/hicolor/${size}/apps/io.tangencylabs.solidcraft.png" \
				644 "usr/share/icons/hicolor/${size}/apps"
		fi
	done

	vlicense LICENSE-APACHE
	vlicense LICENSE-MIT
	if [ -f "NOTICE" ]; then
		vlicense NOTICE
	fi
}
