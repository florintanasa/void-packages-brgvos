# Template file for 'gnome-shell-extension-dash-to-panel'
pkgname=gnome-shell-extension-dash-to-panel
version=73
revision=1
hostmakedepends="unzip"
depends="gnome-shell glib"
short_desc="An icon taskbar for the Gnome Shell"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="GPL-2.0"
homepage="https://extensions.gnome.org"
distfiles="${homepage}/extension-data/dash-to-paneljderose9.github.com.v${version}.shell-extension.zip"

checksum="944ee1408d6f5b6e1cf646bc81dd7af4f9a7bb880b3d88dbb0d90ada8c000410"

do_extract() {
	# Unzip the official .zip archive into the temporary working directory of xbps-src
	unzip -d ${wrksrc} ${XBPS_SRCDISTDIR}/${pkgname}-${version}/dash-to-paneljderose9.github.com.v${version}.shell-extension.zip
}

do_install() {
	# The exact UUID used in the BRGV-OS distribution
	local uuid="dash-to-panel@jderose9.github.com"
	local extdir="usr/share/gnome-shell/extensions/${uuid}"

	# 1. Create the global system extensions path inside the package
	vmkdir "${extdir}"
	
	# 2. Copy all files extracted from zip directly to system destination
	vcopy "*" "${extdir}"

	# 3. Ensure schemas directory exists (required for compilation)
	vmkdir "${extdir}/schemas"
}
