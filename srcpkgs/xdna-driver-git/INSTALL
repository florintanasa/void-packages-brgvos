#/bin/sh
# INSTALL script for xdna-driver-git - for later usage when I can build the driver 

case "$ACTION" in
pre-install)
    # Executed before the package files are written to disk
    echo "=== [NPU] Unloading the stock 'amdxdna' driver from memory... ==="
    if lsmod | grep -q "^amdxdna"; then
        rmmod amdxdna 2>/dev/null || echo "Warning: Could not download the current driver. It may be in use."
    fi
    ;;
post-install)
    # Executed after the files were written and DKMS finished compiling
    echo "=== [NPU] Reindexing modules and loading DKMS driver... ==="
    depmod -a
    modprobe amdxdna 2>/dev/null && echo "=== [NPU] The new driver has loaded successfully! ==="
    ;;
esac
