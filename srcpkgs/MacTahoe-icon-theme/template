# Template file for 'MacTahoe-icon-theme'
pkgname=MacTahoe-icon-theme
version=0.1.0
revision=1
hostmakedepends="tar"
depends=""
short_desc="MacOS Tahoe icons suite for desktops - Base variations"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/florintanasa/MacTahoe-icon-theme"
distfiles="${homepage}/releases/download/v${version}/MacTahoe-icons-all.tar.gz
 ${homepage}/raw/main/COPYING"

checksum="513ed18b7abd25d5ad64dd69fe1ac2bc44dbd8787016260e7aa5138d4067e43a
 8ceb4b9ee5adedde47b31e975c1d90c73ad27b6b165a1dcd80c7c545eb65b903"

nostrip=yes
noverifyrdeps=yes

do_extract() {
	tar -xzf ${XBPS_SRCDISTDIR}/${pkgname}-${version}/MacTahoe-icons-all.tar.gz -C ${wrksrc}
	cp ${XBPS_SRCDISTDIR}/${pkgname}-${version}/COPYING ${wrksrc}/
}

do_install() {
	local icondir="usr/share/icons"
	vmkdir "${icondir}"

	# Install primary base theme components into main payload
	cp -a MacTahoe "${DESTDIR}/${icondir}/" 2>/dev/null || true
	cp -a MacTahoe-dark "${DESTDIR}/${icondir}/" 2>/dev/null || true
	cp -a MacTahoe-light "${DESTDIR}/${icondir}/" 2>/dev/null || true

	vlicense COPYING
}

MacTahoe-icon-theme-blue_package() {
	short_desc="MacOS Tahoe icons suite - Blue variations"
	nostrip=yes
	noverifyrdeps=yes
	pkg_install() {
		local icondir="usr/share/icons"
		vmkdir "${icondir}"
		cp -a ${wrksrc}/MacTahoe-blue "${PKGDESTDIR}/${icondir}/" 2>/dev/null || true
		cp -a ${wrksrc}/MacTahoe-blue-dark "${PKGDESTDIR}/${icondir}/" 2>/dev/null || true
		cp -a ${wrksrc}/MacTahoe-blue-light "${PKGDESTDIR}/${icondir}/" 2>/dev/null || true
	}
}

