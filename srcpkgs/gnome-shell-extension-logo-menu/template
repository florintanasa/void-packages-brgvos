# Template file for 'gnome-shell-extension-logo-menu'
pkgname=gnome-shell-extension-logo-menu
version=41
revision=2
hostmakedepends="unzip"
depends="gnome-shell glib"
short_desc="Logo Menu - Menu similar to Apple's macOS menu for the GNOME Desktop"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="GPL-2.0"
homepage="https://extensions.gnome.org"
distfiles="${homepage}/extension-data/logomenuaryan_k.v${version}.shell-extension.zip
 https://raw.githubusercontent.com/Aryan20/Logomenu/refs/heads/main/LICENSE"

checksum="669ea05161df08c3bec6c81c1abe565ac34c17802263cd75658252a76c2fac81
 8177f97513213526df2cf6184d8ff986c675afb514d4e68a404010521b880643"

do_extract() {
	# Unzip the official .zip archive into the temporary working directory of xbps-src
	unzip -d ${wrksrc} ${XBPS_SRCDISTDIR}/${pkgname}-${version}/logomenuaryan_k.v${version}.shell-extension.zip
	# Copy LICENSE
	cp ${XBPS_SRCDISTDIR}/${pkgname}-${version}/LICENSE ${wrksrc}/
}

do_install() {
	# Local variables
	local uuid="logomenu@aryan_k"
	local extdir="usr/share/gnome-shell/extensions/${uuid}"

	# 1. Install License
	vlicense LICENSE

	# 2. Create the global system extensions path inside the package
	vmkdir "${extdir}"
	
	# 3. Copy all files extracted from zip directly to system destination
	vcopy "*" "${extdir}"

	# 4. Make clean
	rm -f "${DESTDIR}/${extdir}/LICENSE"

	# 5. Ensure schemas directory exists (required for compilation)
	vmkdir "${extdir}/schemas"

	# 6. Fix the rights - eliminate the written right
	find "${DESTDIR}/${extdir}" -type f -exec chmod 644 {} +
	find "${DESTDIR}/${extdir}" -type d -exec chmod 755 {} +
}
