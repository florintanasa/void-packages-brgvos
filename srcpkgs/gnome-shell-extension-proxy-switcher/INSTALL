#!/bin/sh
# This script runs after the package files are unpacked on the target system
case "$1" in
post)
    echo "Compiling GSettings schemas for ProxySwitcher..."
    if [ -d /usr/share/gnome-shell/extensions/ProxySwitcher@flannaghan.com/schemas ]; then
        glib-compile-schemas /usr/share/gnome-shell/extensions/ProxySwitcher@flannaghan.com/schemas
    fi
    ;;
esac
