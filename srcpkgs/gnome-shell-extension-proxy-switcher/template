# Template file for 'gnome-shell-extension-proxy-switcher'
pkgname=gnome-shell-extension-proxy-switcher
version=25
revision=1
hostmakedepends="unzip"
depends="gnome-shell glib"
short_desc="Switches between the system proxy settings profiles defined in Network Settings"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://extensions.gnome.org"
distfiles="${homepage}/extension-data/ProxySwitcherflannaghan.com.v${version}.shell-extension.zip"

checksum="bd5d0f7502097937933ba2b20ed93439ec32cce8566993c4ea74ed45186812cc"

do_extract() {
	# Unzip the official .zip archive into the temporary working directory of xbps-src
	unzip -d ${wrksrc} ${XBPS_SRCDISTDIR}/${pkgname}-${version}/ProxySwitcherflannaghan.com.v${version}.shell-extension.zip
}

do_install() {
	# The exact UUID used in the BRGV-OS distribution
	local uuid="ProxySwitcher@flannaghan.com"
	local extdir="usr/share/gnome-shell/extensions/${uuid}"

	# 1. Create the global system extensions path inside the package
	vmkdir "${extdir}"
	
	# 2. Copy all files extracted from zip directly to system destination
	vcopy "*" "${extdir}"

	# 3. Ensure schemas directory exists (required for compilation)
	vmkdir "${extdir}/schemas"
}
