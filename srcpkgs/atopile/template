# Template file for 'atopile'
pkgname=atopile
version=0.12.5
revision=1
build_style=python3-pep517
hostmakedepends="hatchling hatch-vcs python3-scikit-build-core python3-nanobind ninja zig cmake python3-devel"
makedepends="python3-devel"
depends="python3 python3-case-converter python3-nanobind python3-antlr4-python3-runtime python3-atopile-easyeda2kicad \
black cookiecutter python3-dataclasses-json python3-deprecated python3-fastapi-github-oidc python3-freetype-py python3-GitPython \
python3-httpx python3-kicad-python python3-kicadcliwrapper python3-matplotlib python3-mcp python3-more-itertools python3-natsort \
python3-numpy python3-ordered-set python3-pathvalidate python3-pint python3-platformdirs python3-posthog python3-psutil \
python3-pydantic-settings python3-pygls python3-prompt_toolkit python3-questionary python3-rich python3-ruamel.yaml ruff python3-semver \
python3-sexpdata python3-shapely python3-typer python3-typing_extensions python3-urllib3 python3-truststore python3-zstd"
short_desc="Toolchain bringing the best of software development to the real-world!"
maintainer="Florin Tănasă <florin.tanasa@gmail.com>"
