pre_build() {
	# Use standard scikit-build-core instead of custom fork (editable mode only needed)
	sed -i 's|scikit-build-core @ git+[^"]*|scikit-build-core|' pyproject.toml
	# Allow nanobind <4.0 since 3.1.0 is the latest in repository
	sed -i 's/nanobind>=2\.6\.1,<3\.0/nanobind>=2.6.1,<4.0/' pyproject.toml
	# Fix Python 3.14 PEP 649 annotation shadowing of 'list' by CLI command list()
	for f in src/atopile/cli/*.py; do
		if grep -q '^def list(' "$f"; then
			sed -i '1i import builtins' "$f"
			sed -i 's/\blist\[/builtins.list[/g' "$f"
		fi
	done
}

post_install() {
	sed -n '/^License:/,/^Classifier:/p' PKG-INFO > LICENSE 
	vlicense LICENSE
}
