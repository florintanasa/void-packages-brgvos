# Template file for 'llamacpp'
pkgname=llamacpp
version=0.3.0
revision=2
build_style=cmake
configure_args="-DGGML_VULKAN=ON -DGGML_BLAS=ON -DGGML_BLAS_VENDOR=OpenBLAS -DCMAKE_BUILD_TYPE=Release -DLLAMA_BUILD_TESTS=OFF -DCMAKE_INSTALL_LIBDIR=lib"
hostmakedepends="pkg-config cmake ninja git nodejs shaderc glslang"
makedepends="vulkan-loader-devel openssl-devel libgomp-devel SPIRV-Headers openblas-devel"
depends=""

# System accounts and isolation parameters
system_groups="llm"
system_accounts="llamacpp"
llamacpp_groups="video,llm"
llamacpp_homedir="/var/lib/llamacpp"
llamacpp_shell="/sbin/nologin"

# Protect configuration files from being overwritten during package updates
conf_files="/etc/llamacpp/conf.d/zz-secrets.conf /etc/llamacpp/conf.d/llama.conf"

short_desc="LLM inference in C/C++ with Vulkan backend and OpenBLAS CPU Acceleration"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="MIT"
homepage="https://github.com/ggml-org/llama.cpp"
distfiles="${homepage}/archive/refs/tags/v${version}.tar.gz>llamacpp-${version}.tar.gz"

checksum="d94c02d86db22d68692f6bb5b3854763d5091e52142868dc7251995517c666d1"

post_install() {
	# 1. Create service private storage directories and drop-in config path
	mkdir -p ${DESTDIR}/var/lib/llamacpp
	mkdir -p ${DESTDIR}/etc/llamacpp/conf.d
	touch ${DESTDIR}/var/lib/llamacpp/.keep_llamacpp-server_0

	# 2. Install the configuration drop-ins directly (protected by conf_files)
	vinstall ${FILESDIR}/zz-secrets.conf 640 etc/llamacpp/conf.d
	vinstall ${FILESDIR}/llama.conf 644 etc/llamacpp/conf.d

	# 3. Prepare the central shared LLM repository structure within destdir
	mkdir -p ${DESTDIR}/var/lib/llms/huggingface
	touch ${DESTDIR}/var/lib/llms/huggingface/.keep_llamacpp_0

	# 4. Automatically install the runit service script from files/llama-server/run
	vsv llama-server
}

llamacpp-devel_package() {
	short_desc+=" - development files"
	depends="${sourcepkg}>=${version}_${revision}"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
