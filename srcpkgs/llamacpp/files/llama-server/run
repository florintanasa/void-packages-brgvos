#!/bin/sh
# Runit service for llama-server in BRGV-OS

# Redirect standard errors to the system log
exec 2>&1

# Ensure environment profiles are loaded if present
[ -r ./conf ] && . ./conf

# Load drop-in configuration secrets if present in /etc
if [ -d /etc/llamacpp/conf.d ]; then
	for f in /etc/llamacpp/conf.d/*.conf; do
		[ -r "$f" ] && . "$f"
	done
fi

# Ensure the shared storage group exists before managing permissions
getent group llm >/dev/null || groupadd -r llm

# Dynamically align the llamacpp user into the llm group if not already present
if getent passwd llamacpp >/dev/null; then
	id -nG llamacpp | grep -q llm || usermod -aG llm llamacpp
fi

# NATIVE BRGV-OS PERMISSION ASSURANCE (Runs as root before chpst)
# Set ownership and permissions on service-specific private directories
chown -R llamacpp:llamacpp /var/lib/llamacpp /etc/llamacpp
chmod 750 /var/lib/llamacpp /etc/llamacpp

# Enforce shared group ownership and permissions for the multi-backend repository recursively
if [ -d /var/lib/llms ]; then
	chown -R root:llm /var/lib/llms
	find /var/lib/llms -type d -exec chmod 2770 {} +
	find /var/lib/llms -type f -exec chmod 660 {} +
fi

# Create runtime directory in /run (tmpfs) and assign ownership to user llamacpp
mkdir -p /run/llamacpp
chown llamacpp:llamacpp /run/llamacpp
chmod 700 /run/llamacpp

# Export variables for Hugging Face storage redirection to the shared repository
export HOME="/var/lib/llamacpp"
export XDG_RUNTIME_DIR="/run/llamacpp"
export RUNTIME_DIRECTORY="/run/llamacpp"
export HF_HOME="/var/lib/llms/huggingface"

# Inject API key if defined via drop-in configs
if [ -n "$LLAMA_API_KEY" ]; then
	export LLAMA_API_KEY="$LLAMA_API_KEY"
fi

# Verify the existence of the working directory before execution
cd /var/lib/llamacpp || exit 1

# Default environment values if not overridden in ./conf or drop-ins
: ${HOST:="127.0.0.1"}
: ${PORT:="9931"}
: ${OPTS:="-fa on -ngl 99 -t 4 -b 512 -ub 128 -ctk q4_0 -ctv q4_0"}

# Launch the isolated server under the designated user and supplementary groups
exec chpst -u llamacpp:llamacpp:video:llm llama-server --host "$HOST" --port "$PORT" $OPTS

