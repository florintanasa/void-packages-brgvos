# Template file for 'gnome-shell-extension-space-bar'
pkgname=gnome-shell-extension-space-bar
version=34
revision=2
hostmakedepends="unzip"
depends="gnome-shell glib"
short_desc="Replaces the top-panel workspace indicator with an i3-like workspaces bar"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="custom:source-not-found"
homepage="https://extensions.gnome.org"
distfiles="${homepage}/extension-data/space-barluchrioh.v${version}.shell-extension.zip"

checksum="6ade875e4423903e73d006139b28af9e98d85e64e7eb9272d98e640390ee60f1"

do_extract() {
	# Unzip the official .zip archive into the temporary working directory of xbps-src
	unzip -d ${wrksrc} ${XBPS_SRCDISTDIR}/${pkgname}-${version}/space-barluchrioh.v${version}.shell-extension.zip
}

do_install() {
	# The exact UUID used in the BRGV-OS distribution
	local uuid="space-bar@luchrioh"
	local extdir="usr/share/gnome-shell/extensions/${uuid}"

	# 1. Create the global system extensions path inside the package
	vmkdir "${extdir}"
	
	# 2. Copy all files extracted from zip directly to system destination
	vcopy "*" "${extdir}"

	# 3. Ensure schemas directory exists (required for compilation)
	vmkdir "${extdir}/schemas"

	# 4. Fix the rights - eliminate the written right
	find "${DESTDIR}/${extdir}" -type f -exec chmod 644 {} +
	find "${DESTDIR}/${extdir}" -type d -exec chmod 755 {} +
}
