# Template file for 'waterfox'
pkgname=waterfox
version=6.7.5
revision=1
archs="x86_64"
short_desc="Web browser focused on privacy out of the box and customisation to your taste"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="MPL-2.0"
homepage="https://www.waterfox.net/"
changelog="https://www.waterfox.net/docs/releases/G${version}/?update"
distfiles=https://cdn.waterfox.com/waterfox/releases/${version}/Linux_x86_64/waterfox-${version}.tar.bz2

checksum=9f8329ef1f94b60f291281f9da8f35a0ee9d5872c3a1fef9dba7629eca24a0b1

nopie=yes


do_install() {
	vmkdir opt/waterfox
	vcopy "*" opt/waterfox
	vmkdir usr/bin
	ln -s /opt/waterfox/waterfox "${DESTDIR}/usr/bin/waterfox"
	vmkdir usr/share/pixmaps
	vinstall "${DESTDIR}/opt/waterfox/browser/chrome/icons/default/default128.png" 644 \
usr/share/pixmaps/ waterfox.png
	vmkdir usr/share/applications
	vinstall "${FILESDIR}/waterfox.desktop" 644 usr/share/applications/
}
