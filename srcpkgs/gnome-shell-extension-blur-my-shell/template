# Template file for 'gnome-shell-extension-blur-my-shell'
pkgname=gnome-shell-extension-blur-my-shell
version=72
revision=1
hostmakedepends="unzip"
depends="gnome-shell glib"
short_desc="Adds a blur look to different parts of the GNOME Shell, including the top panel, dash and overview"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="GPL-2.0"
homepage="https://extensions.gnome.org"
distfiles="${homepage}/extension-data/blur-my-shellaunetx.v${version}.shell-extension.zip"

checksum="4b82a0a0be4f2f917bff88e0952fab4d6c347d1128e7d8487caef240b699a910"

do_extract() {
	# Unzip the official .zip archive into the temporary working directory of xbps-src
	unzip -d ${wrksrc} ${XBPS_SRCDISTDIR}/${pkgname}-${version}/blur-my-shellaunetx.v${version}.shell-extension.zip
}

do_install() {
	# The exact UUID used in the BRGV-OS distribution
	local uuid="blur-my-shell@aunetx"
	local extdir="usr/share/gnome-shell/extensions/${uuid}"

	# 1. Create the global system extensions path inside the package
	vmkdir "${extdir}"
	
	# 2. Copy all files extracted from zip directly to system destination
	vcopy "*" "${extdir}"

	# 3. Ensure schemas directory exists (required for compilation)
	vmkdir "${extdir}/schemas"
}
