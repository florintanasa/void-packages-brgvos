 -DBUILD_TESTING=OFF
 -DMITCAD_RUST_COMPILER_CACHE=OFF
 -DCMAKE_EXE_LINKER_FLAGS=-Wl,--exclude-libs,ALL"
hostmakedepends="pkg-config ninja cmake rust cargo clang git python3
 autoconf autoconf-archive automake libtool qt6-base qt6-tools curl zip unzip tar patchelf"
makedepends="qt6-base-devel qt6-tools-devel qt6-translations qt6-svg-devel
 libsecret-devel MesaLib-devel libglvnd-devel
 libX11-devel libXext-devel libXi-devel libXrandr-devel
 libXcursor-devel libXinerama-devel libxkbcommon-devel
 libxcb-devel xcb-util-keysyms-devel xcb-util-image-devel
 xcb-util-wm-devel xcb-util-renderutil-devel xcb-util-cursor-devel
 fontconfig-devel freetype-devel dbus-devel
 nss-devel nspr-devel at-spi2-atk-devel cups-devel
 libgbm-devel libdrm-devel pango-devel cairo-devel alsa-lib-devel"
