# Template file for 'gnome-shell-extension-customize-ibus'
pkgname=gnome-shell-extension-customize-ibus
version=94
revision=2
hostmakedepends="unzip"
depends="gnome-shell glib"
short_desc="Full customization of appearance, behavior, system tray and input source indicator"
maintainer="Florin Tanasă <florin.tanasa@gmail.com>"
license="GPL-3.0"
homepage="https://extensions.gnome.org"
distfiles="${homepage}/extension-data/customize-ibushollowman.ml.v${version}.shell-extension.zip
 https://raw.githubusercontent.com/openSUSE/Customize-IBus/refs/heads/main/LICENSE"

checksum="8972e1abd9e7911c385f10169cd96bc8842b6e5325fd6781a68ffa0abb456b49
 3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"

do_extract() {
	# Unzip the official .zip archive into the temporary working directory of xbps-src
	unzip -d ${wrksrc} ${XBPS_SRCDISTDIR}/${pkgname}-${version}/customize-ibushollowman.ml.v${version}.shell-extension.zip
	# Copy LICENSE
	cp ${XBPS_SRCDISTDIR}/${pkgname}-${version}/LICENSE ${wrksrc}/
}

do_install() {
	# Local vaiables
	local uuid="customize-ibus@hollowman.ml"
	local extdir="usr/share/gnome-shell/extensions/${uuid}"

	# 1. Install License
	vlicense LICENSE

	# 2. Create the global system extensions path inside the package
	vmkdir "${extdir}"
	
	# 3. Copy all files extracted from zip directly to system destination
	vcopy "*" "${extdir}"

	# 4. Make clean
	rm -f "${DESTDIR}/${extdir}/LICENSE"

	# 5. Ensure schemas directory exists (required for compilation)
	vmkdir "${extdir}/schemas"

	# 6. Fix the rights - eliminate the written right
	find "${DESTDIR}/${extdir}" -type f -exec chmod 644 {} +
	find "${DESTDIR}/${extdir}" -type d -exec chmod 755 {} +
}
